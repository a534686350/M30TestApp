<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ════════════════════════════════════════════════════════════
         工控上位机 · 深色主题 v4（2026-10-28 全项目换肤）
         深蓝黑底 + 蓝主色 + 琥珀辅助；层次靠明度差，不靠重边框
         取色依据：ui-ux-pro-max 的 design-system 输出（primary #1E40AF / accent #D97706）
         深色场景适配：蓝提到 #3B82F6 保证深底可读，实心按钮底压到 #2563EB 保白字 5.2:1
         ════════════════════════════════════════════════════════════ -->
    <Color x:Key="BgColor">#FF101828</Color>
    <Color x:Key="BgGradientStart">#FF101828</Color>
    <Color x:Key="BgGradientEnd">#FF101828</Color>
    <Color x:Key="SurfaceColor">#FF17212F</Color>
    <Color x:Key="BorderColor">#FF26364C</Color>
    <Color x:Key="TextColor">#FFE8EEF7</Color>
    <Color x:Key="MutedColor">#FF9BABC2</Color>
    <Color x:Key="AccentColor">#FF3B82F6</Color>
    <Color x:Key="AccentColorHover">#FF60A5FA</Color>
    <Color x:Key="AccentLight">#FF15253D</Color>
    <Color x:Key="SuccessColor">#FF10B981</Color>
    <Color x:Key="WarnColor">#FFF59E0B</Color>
    <Color x:Key="ErrorColor">#FFF87171</Color>
    <Color x:Key="HeaderBgColor">#FF1B2738</Color>
    <Color x:Key="RowAltColor">#FF131C29</Color>
    <Color x:Key="SidebarBg">#FF131C29</Color>
    <Color x:Key="NavHoverBg">#FF1E2C40</Color>
    <Color x:Key="MenuBarColor">#FF131C29</Color>
    <Color x:Key="ToolbarColor">#FF161F2E</Color>
    <Color x:Key="StatusBarColor">#FF131C29</Color>
    <Color x:Key="PageHeaderColor">#FF141D2B</Color>
    <Color x:Key="SidebarHeaderColor">#FF1A2534</Color>
    <Color x:Key="DeviceStripColor">#FF161F2E</Color>
    <Color x:Key="RunStatusColor">#FF15253D</Color>

    <SolidColorBrush x:Key="BgBrush"          Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush"        Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush"       Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorHover}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarnBrush"        Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="ErrorBrush"       Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="HeaderBgBrush"    Color="{StaticResource HeaderBgColor}"/>
    <SolidColorBrush x:Key="RowAltBrush"      Color="{StaticResource RowAltColor}"/>
    <SolidColorBrush x:Key="NavHoverBrush"    Color="{StaticResource NavHoverBg}"/>
    <SolidColorBrush x:Key="MenuBarBrush"     Color="{StaticResource MenuBarColor}"/>
    <SolidColorBrush x:Key="ToolbarBrush"     Color="{StaticResource ToolbarColor}"/>
    <SolidColorBrush x:Key="StatusBarBrush"   Color="{StaticResource StatusBarColor}"/>
    <SolidColorBrush x:Key="PageHeaderBrush"  Color="{StaticResource PageHeaderColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"     Color="{StaticResource SidebarBg}"/>
    <SolidColorBrush x:Key="SidebarHeaderBrush" Color="{StaticResource SidebarHeaderColor}"/>
    <SolidColorBrush x:Key="DeviceStripBrush" Color="{StaticResource DeviceStripColor}"/>
    <SolidColorBrush x:Key="RunStatusBrush"   Color="{StaticResource RunStatusColor}"/>
    <!-- 矩阵大表网格线（Excel 式细格）：只在采集矩阵里启用，其它表格仍无竖线 -->
    <SolidColorBrush x:Key="GridLineBrush"    Color="#FF22314A"/>
    <!-- 交互反馈：悬停底色（表格单元格 / 行）与按下态 -->
    <SolidColorBrush x:Key="RowHoverBrush"    Color="#FF18283E"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF0F2C55"/>

    <!-- 实心主色（按钮底）：比 AccentBrush 深一档，保证白字对比度 5.2:1 -->
    <SolidColorBrush x:Key="AccentSolidBrush" Color="#FF2563EB"/>

    <!-- 卡片底：纵向微渐变，靠明度差拉层次（纯色块在深色下会显得平） -->
    <LinearGradientBrush x:Key="CardBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1A2534" Offset="0"/>
        <GradientStop Color="#FF161F2E" Offset="1"/>
    </LinearGradientBrush>

    <!-- 新增：新外壳专用（横幅/页签/面板头/LED） -->
    <SolidColorBrush x:Key="TabStripBrush"    Color="#FF131C29"/>
    <SolidColorBrush x:Key="TabActiveBrush"   Color="#FF1E2C40"/>
    <SolidColorBrush x:Key="BannerChipBrush"  Color="#FF1B2738"/>
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#FF1B2738"/>
    <SolidColorBrush x:Key="PanelBodyBrush"   Color="#FF131C29"/>
    <SolidColorBrush x:Key="LedOnBrush"       Color="#FF10B981"/>
    <SolidColorBrush x:Key="LedOffBrush"      Color="#FF64748B"/>
    <SolidColorBrush x:Key="LedWarnBrush"     Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="LedErrorBrush"    Color="#FFF87171"/>
    <SolidColorBrush x:Key="BannerAlarmBrush" Color="#FF3A2024"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#FF33475F"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF4A6180"/>
    <SolidColorBrush x:Key="DividerBrush"     Color="#FF26364C"/>

    <!-- 标题横幅专用文字色 -->
    <SolidColorBrush x:Key="TitleFgBrush"  Color="#FFF2F7FC"/>
    <SolidColorBrush x:Key="TitleSubBrush" Color="#FFA6BCD4"/>
    <!-- 工位表已扫码行高亮 -->
    <SolidColorBrush x:Key="ScannedRowBrush" Color="#FF172820"/>
    <SolidColorBrush x:Key="NextRowBrush" Color="#FF45320F"/>
    <!-- 长期稳定性矩阵：温度分组表头的交替底色（必须走主题，否则深色下露出浅蓝块） -->
    <SolidColorBrush x:Key="GroupHeaderBrushA" Color="#FF1E2C40"/>
    <SolidColorBrush x:Key="GroupHeaderBrushB" Color="#FF243248"/>

    <SolidColorBrush x:Key="BgGradientBrush" Color="{StaticResource BgColor}"/>
    <!-- 标题栏：深蓝黑纵向渐变 -->
    <LinearGradientBrush x:Key="TopBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1B2738" Offset="0"/>
        <GradientStop Color="#FF101828" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
    <DropShadowEffect x:Key="CardShadowHover" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
    <DropShadowEffect x:Key="NavShadow" BlurRadius="0" ShadowDepth="0" Opacity="0"/>

    <!-- ────────── 排版标度（5 档，两主题必须一致） ──────────
         原来 Dark/Light 各写一套（12.5/11.5/14 vs 13/12/15），切主题字会跳，已统一。
         Caption 辅助说明 / Small 标签表头 / Normal 正文输入 / Heading 卡片标题 / Title 页面标题 -->
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeNormal">13</sys:Double>
    <sys:Double x:Key="FontSizeHeading">15</sys:Double>
    <sys:Double x:Key="FontSizeTitle">17</sys:Double>

    <!-- ────────── 按钮：圆角扁平，实心主色 + 描边次级 ────────── -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource CardShadow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：底色 + 边框 + 文字一起变主色，和浅色主题一致（原来只换底色，几乎看不出来） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 兜底：没有显式 Style 的按钮（对话框的「确定 / 取消」、卡片里的「刷新」等）
         也要跟着主题走。不写这条会用系统默认样式 —— 深色主题下这些按钮会露出浅色底。 -->
    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="11,5"/>
    </Style>

    <!-- ────────── 排版语义样式 ──────────
         这两个原来在 ConfigView / QuickTestView 各写一遍，字号和边距还不一样（12.5/12、5/4）。
         统一到这里，View 里删掉本地定义，改由主题兜底。 -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ────────── 卡片面板：圆角 1px 描边，微渐变底 ────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
    </Style>

    <Style x:Key="NavGroupTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- ────────── 工具栏按钮 ────────── -->
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 启动（绿）/ 停止（红）：工控主操作钮 -->
    <Style x:Key="ToolbarStartButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="20,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarStopButton" TargetType="Button" BasedOn="{StaticResource ToolbarStartButton}">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <Style x:Key="ToolbarSeparator" TargetType="Separator">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Width="1" Height="24" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ────────── 顶部模块页签：深底 → 选中转亮 + 上沿强调条 ────────── -->
    <Style x:Key="MainTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="0,2,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 兼容保留：旧侧栏导航样式键（新外壳已不使用，仅防外部引用解析失败） -->
    <Style x:Key="NavButton" TargetType="RadioButton" BasedOn="{StaticResource MainTab}"/>

    <!-- ────────── 分段选择器：相邻按钮边框合并成一组 ────────── -->
    <Style x:Key="ModeTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}" Margin="0,0,-1,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ────────── 面板：标题栏 + 内容体（页面内部统一） ────────── -->
    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="PanelTitleBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Height" Value="28"/>
    </Style>

    <Style x:Key="PanelTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ────────── 页面头：面包屑 + 页名 ────────── -->
    <Style x:Key="PageHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PageHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Height" Value="34"/>
    </Style>

    <Style x:Key="PageHeaderCrumb" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageHeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ────────── 左侧竖排子导航（设置类页面用：条目多时比横排页签好用） ────────── -->
    <Style x:Key="SideTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 分组留白加大后总高度会超出窗口，套 ScrollViewer 兜底；
                             去掉 VerticalAlignment=Top 让 Border 撑满，否则 ScrollViewer 没有可滚高度 -->
                        <Border Grid.Column="0" Width="160"
                                Background="{DynamicResource SidebarHeaderBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0">
                                <StackPanel IsItemsHost="True" Margin="0,8,0,8"/>
                            </ScrollViewer>
                        </Border>
                        <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="12,0,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideTabItem" TargetType="TabItem">
        <!-- 排版 v2：分组标题留白加大、子项缩进 8px，让「分组 → 子项」的层级看得出来 -->
        <Setter Property="Padding" Value="24,0"/>
        <!-- 必须用 MinHeight：固定 Height 会把「分组标题 + 子项」压扁，子项互相重叠 -->
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="160"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <StackPanel>
                        <!-- 分组标题：只在设了 Tag 的组首项上出现（Tag 为空则整块折叠） -->
                        <TextBlock x:Name="GrpTitle" Text="{TemplateBinding Tag}"
                                   FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="16,8,0,4"/>
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="GrpTitle" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ────────── 菜单栏 / 菜单项（工业深色） ────────── -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource MenuBarBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MIIcon"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="8,0,2,0"
                                              VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="8,0,8,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Margin="12,0,8,0" VerticalAlignment="Center"
                                       FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                            <Grid Grid.Column="3">
                                <Path x:Name="Arrow" VerticalAlignment="Center" Margin="4,0,8,0"
                                      Data="M0,0 L4,4 L0,8 Z" Fill="{DynamicResource MutedBrush}"
                                      Visibility="Collapsed"/>
                                <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            MinWidth="180" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Padding" Value="12,6"/>
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter Property="Padding" Value="12,6"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter Property="Padding" Value="2,6"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter Property="Padding" Value="2,6"/>
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger SourceName="PART_Popup" Property="IsOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分组线（菜单分隔） -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ────────── 数据表格：高密度 ────────── -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#FF1E2A3C"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
        <!-- 必须显式设文字色：DataGridTextColumn 生成的 TextBlock 会把 Foreground 绑到
             DataGridCell 的 Foreground，而 Cell 继承自窗口；窗口没设 → 落到 WPF 默认黑色。
             浅色主题下看不出问题，深色主题就是「黑字贴深底」看不清。 -->
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource RowAltBrush}"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="ColumnHeaderHeight" Value="34"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    </Style>

    <!-- 表头：冷蓝灰字 + 深底，仪表读数感（不用高饱和青色，长时间盯屏会累） -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
        <Setter Property="Foreground" Value="#FFA8C0DC"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 行号栏（RowHeader）：不写这条会用系统默认的白底，深色主题下表格左边露出一条白边 -->
    <Style TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>


    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <!-- BorderBrush/Thickness 走 TemplateBinding：默认厚度 0（无格线），
                         只有采集矩阵用 CellStyle 打开 0,0,1,1，做 Excel 式细格。 -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 悬停：淡主色底，指针在哪看得清（写在选中之前，选中态仍优先） -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 行悬停：DataGrid 会把 RowBackground/AlternatingRowBackground 写成行的本地值（优先于样式触发器），
         所以这条只对没有行底色的表格生效；带斑马纹的表格靠单元格悬停反馈。 -->
    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ────────── 文本 / 输入 ────────── -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FF0D1520"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,4"/>
        <!-- 与下面 ComboBox 的 MinHeight 保持一致：此前 TextBox 由 Padding 算出来只有 26，
             ComboBox 被 MinHeight 撑到 28，同一排里输入框和下拉框会差 2px 对不齐。 -->
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>

                                <!-- 展开开关：自定义模板必须自带这个 ToggleButton 并垫在最底层、
                                     跨满两列，否则点控件/箭头都不会展开下拉（WPF 默认模板就是靠它开合）。
                                     透明模板盖掉系统按钮外观；箭头 Path 设 IsHitTestVisible=False 让点击穿透到它。 -->
                                <ToggleButton x:Name="toggleButton"
                                              Grid.ColumnSpan="2"
                                              Focusable="False" IsTabStop="False" ClickMode="Press"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- 非编辑态：显示当前选中项 -->
                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>

                                <!-- 可编辑态：内嵌输入框（设备型号 / 方案名等可输入下拉要用） -->
                                <!-- 可编辑态：必须把 ComboBox.Text 绑进来。只用 PVT 的
                                     FallbackValue 那套靠 ComboBox 内部回填，模板一换就丢
                                     —— 现场表现是「可输入的下拉框里文字整个不显示」。 -->
                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Margin="{TemplateBinding Padding}"
                                         VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{TemplateBinding Foreground}"
                                         Visibility="Hidden"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>

                                <Path x:Name="Arrow" Grid.Column="1"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Slide" Focusable="False">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,2,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉列表项：不写这条会用系统默认（深色主题下白底深字或高亮不可控） -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ────────── Tab：文件页签式，下沿强调条 ────────── -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource TabStripBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="8,0,0,0"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 子页签：扁平分段，选中项面板底 + 下沿强调条；不要方框、不要虚线焦点框 -->
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ────────── CheckBox ────────── -->
    <!-- 自带模板（系统默认是方形直角、悬停无反馈，和深色扁平风格不搭）；勾选后填充主色 + 白勾 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Tick" Text="✓" FontSize="11" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ────────── 进度条：方形段码感 ────────── -->
    <!-- 单选框：与 CheckBox 同一套观感 -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="15" Height="15" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{DynamicResource SurfaceBrush}"
                                     Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 提示气泡：系统默认是浅色，深色下很扎眼 -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="3">
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="3" HorizontalAlignment="Left" Margin="1"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ────────── 滚动条：细方轨 ──────────
         注意：必须按 Orientation 分别设置。横向滚动条的"长度"就是它的 Width，
         若对横向条也设 Width/MinWidth=8，整条会塌成 8px 的小疙瘩、无法点击。 -->
    <!-- 滚动条：必须自带模板。原来只设了尺寸，用的还是系统默认模板 ——
         深色主题下整条是浅色的，在矩阵右侧露出一道白。 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <!-- 尺寸**只能按方向分别设**：横向滚动条的"长度"就是它的 Width，
             基础 setter 里一旦写死 Width=10，整条会塌成 10px 的小疙瘩 ——
             看着像"只有中间一个点"、还点不着。所以宽度只在 Vertical 触发器里给，
             高度只在 Horizontal 触发器里给。 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" MinHeight="24" MinWidth="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bd" CornerRadius="5" Margin="2,1"
                                                    Background="{DynamicResource ScrollThumbBrush}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <!-- 横向时 thumb 的"长度"看 MinWidth，MinHeight 归零免得把条撑高 -->
                            <Setter TargetName="Thumb" Property="MinHeight" Value="0"/>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="Thumb" Property="MinWidth" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
