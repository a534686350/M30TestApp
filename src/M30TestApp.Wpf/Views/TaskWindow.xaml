<Window x:Class="M30TestApp.Wpf.Views.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="测试任务" Width="1400" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}"
        ShowInTaskbar="False">
    <!--
        测试任务独立窗口（2026-11-24）—— 每个测试任务一个窗口，一次只能开一个。
        ContentControl 里放的是 MainViewModel 的长生命周期任务 VM 单例，
        App.xaml 的 DataTemplate 会自动把它渲染成对应的 View（TestRunView / QuickTestView / ManualView）。
        顶栏带开始/停止与返回主界面，任务窗自成一体。
    -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource TopBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="TitleText" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleFgBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RunStateText" Text="" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶ 开始测试" Style="{StaticResource PrimaryButton}"
                            Height="32" Padding="14,0" Margin="0,0,8,0"
                            Command="{Binding StartSelectedRunCommand}" ToolTip="开始当前任务（F5）"/>
                    <Button Content="■ 停止" Style="{StaticResource GhostButton}"
                            Height="32" Padding="14,0" Margin="0,0,8,0"
                            Command="{Binding StopSelectedRunCommand}"/>
                    <!-- 运行中主窗被隐藏、工位表锁定，这里给个只读核对入口 -->
                    <Button Content="本轮工位" Style="{StaticResource GhostButton}"
                            Height="32" Padding="12,0" Margin="0,0,8,0"
                            Click="ShowSlots_Click" ToolTip="只读查看本轮测试用了哪些工位"/>
                    <Button Content="返回主界面" Style="{StaticResource GhostButton}"
                            Height="32" Padding="12,0" Click="Close_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl x:Name="TaskHost"/>
    </DockPanel>
</Window>
