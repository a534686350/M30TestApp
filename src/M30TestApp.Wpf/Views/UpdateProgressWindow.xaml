<Window x:Class="M30TestApp.Wpf.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="????"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource SurfaceBrush}">
    <Border Padding="26" Background="{DynamicResource SurfaceBrush}">
        <StackPanel>
            <TextBlock Text="??????"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="?????????????,??????"
                       FontSize="12"
                       Foreground="{DynamicResource MutedBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>

            <TextBlock x:Name="StatusText"
                       Text="??????..."
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <Grid x:Name="ProgressTrack"
                  Height="14"
                  ClipToBounds="True"
                  Margin="0,0,0,8"
                  SizeChanged="OnProgressTrackSizeChanged">
                <Border Background="{DynamicResource HeaderBgBrush}"
                        CornerRadius="7"/>
                <Border x:Name="ProgressFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="7"/>
            </Grid>

            <TextBlock x:Name="PercentText"
                       Text=""
                       FontSize="12"
                       Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>