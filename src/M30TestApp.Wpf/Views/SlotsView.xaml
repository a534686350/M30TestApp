<UserControl x:Class="M30TestApp.Wpf.Views.SlotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:SlotsViewModel}"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!--
        顶部「工位」页签的页面 —— 面向**不需要扫码**的场景：
          输入工位数量 → 生成工位表 → 看表格。没有扫码录入条，也没有右侧窄栏。
        工位数据全部来自 ConfigViewModel（同一份），自动测试 / 长期稳定性 / 快速测试共用。
        需要扫码录入的现场场景请走「配置 → 工位」。
    -->
    <UserControl.Resources>
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="62"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="VDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Row0 工具条：布局参数在左，导入/导出/独立编辑在右 ══ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="导入 CSV" Style="{StaticResource GhostButton}" Height="28" Padding="12,0" FontSize="{StaticResource FontSizeNormal}"
                            Command="{Binding Config.ImportSlotsCommand}"
                            ToolTip="从 CSV 导入工位表（覆盖当前表）"/>
                    <Button Content="导出 CSV" Style="{StaticResource GhostButton}" Height="28" Padding="12,0" FontSize="{StaticResource FontSizeNormal}" Margin="8,0,0,0"
                            Command="{Binding Config.ExportSlotsCommand}"
                            ToolTip="把当前工位表导出为 CSV"/>
                    <Button Content="独立编辑" Style="{StaticResource GhostButton}" Height="28" Padding="12,0" FontSize="{StaticResource FontSizeNormal}" Margin="8,0,0,0"
                            Click="OpenSlotsWindow_Click"
                            ToolTip="隐藏主界面，在独立窗口中放大编辑工位表"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="工位数量" Style="{StaticResource ToolLabel}"/>
                    <!-- 不能用 PropertyChanged：SlotCount setter 带 Math.Clamp，
                         逐字回写会把输入中间态当终值（想输 9 时中间态被夹回 10），
                         现场就是因此「侧边栏改 9、实际跑 10」。改完失焦或点「生成工位表」才生效。 -->
                    <TextBox Style="{StaticResource NumBox}"
                             Text="{Binding Config.SlotCount}"
                             ToolTip="改数量后按回车 / 点「生成工位表」生效；别用逐字输入触发 Clamp"/>
                    <!-- 用 PrimaryButton（与配置页的「刷新工位表」同一个蓝），
                         不用 SaveButton —— 绿色在这个界面是「保存」的语义，出现在这排会误导。 -->
                    <Button Content="生成工位表" Style="{StaticResource PrimaryButton}"
                            Height="28" Padding="12,0" FontSize="{StaticResource FontSizeNormal}" Margin="8,0,0,0"
                            Command="{Binding Config.RegenerateSlotsCommand}"
                            ToolTip="按当前参数重新生成；已手工改过的序列号会尽量保留"/>

                    <Rectangle Style="{StaticResource VDivider}"/>
                    <TextBlock Text="起始编号" Style="{StaticResource ToolLabel}"/>
                    <TextBox Style="{StaticResource NumBox}"
                             Text="{Binding Config.StartIndex, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="第一个工位的编号，例如 1 或 129"/>

                    <Rectangle Style="{StaticResource VDivider}"/>
                    <TextBlock Text="批次号" Style="{StaticResource ToolLabel}"/>
                    <TextBox Style="{StaticResource NumBox}" Width="108"
                             Text="{Binding Config.BatchNo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="写入报表的批次号，例：260826_01"/>

                    <Rectangle Style="{StaticResource VDivider}"/>
                    <CheckBox Content="自动编号" VerticalAlignment="Center"
                              IsChecked="{Binding Config.AutoNumber}"
                              ToolTip="按起始 ID 自动填充序列号"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Row1 工位明细表（占满整宽） ══ -->
        <Border Grid.Row="1" Style="{StaticResource PanelCard}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource FontSizeSmall}">
                            <Run Text="共 "/>
                            <Run Text="{Binding Config.PreviewCount, Mode=OneWay}"/>
                            <Run Text=" / 256 行"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="工位明细" Style="{StaticResource PanelTitleText}"/>
                            <!-- 973 台数自动判读：1-18 → 1 台，19-36 → 2 台，37-54 → 3 台；
                                 配置不足时变红提醒去「配置 → 设备」启用 -->
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Text="{Binding Config.DmmUnitHint}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Config.DmmUnitShortage}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 粘贴/编辑反馈（如「已粘贴 5 个序列号」） -->
                            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding Config.StatusMessage}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- IsReadOnly 必须显式关掉：主题里全局 DataGrid 样式默认只读。
                     只有「序列号」列开放编辑（其余列是布局参数，改了会和布局公式打架）。
                     支持从 Excel 复制一列序列号后 Ctrl+V 批量粘贴（见 code-behind）。 -->
                <DataGrid x:Name="SlotGrid" ItemsSource="{Binding Config.Slots}" BorderThickness="0"
                          SelectionMode="Single"
                          IsReadOnly="False"
                          PreviewKeyDown="SlotGrid_PreviewKeyDown"
                          CellEditEnding="SlotGrid_CellEditEnding"
                          AutoGenerateColumns="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          FrozenColumnCount="1"
                          GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <!-- 不设 RowStyle：配置页那套「绿底 = 已录入 / 琥珀 = 待扫码」是**扫码**语义，
                         这一页没有扫码，全部行都填了自动序列号 → 整片绿底只是噪声。 -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="工位"        Binding="{Binding Slot}"          Width="76"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="序列号"      Binding="{Binding SerialNo}"      Width="220"/>
                        <DataGridTextColumn Header="坐标X"      Binding="{Binding PositionX}"      Width="70"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="坐标Y"      Binding="{Binding PositionY}"      Width="70"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="板卡位"      Binding="{Binding Board}"         Width="80"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="板卡工位号"  Binding="{Binding BoardSlotNo}"   Width="90"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="夹具位"      Binding="{Binding Fixture}"       Width="70"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="夹具工位号"  Binding="{Binding FixtureSlotNo}" Width="90"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="阀位"        Binding="{Binding Valve}"         Width="60"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="阀门"        Binding="{Binding ValveAddr}"     Width="70"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="压力控制器"  Binding="{Binding PressureController}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="973 台号"     Binding="{Binding Dmm}"           Width="90"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="通道"        Binding="{Binding Channel}"       Width="70"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="层数"        Binding="{Binding Layer}"         Width="60"  IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
