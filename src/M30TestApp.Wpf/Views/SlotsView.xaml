<UserControl x:Class="M30TestApp.Wpf.Views.SlotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:SlotsViewModel}"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!--
        顶部「工位」页签的页面 —— 面向**不需要扫码**的场景：
          输入工位数量 → 生成工位表 → 看表格。没有扫码录入条，也没有右侧窄栏。
        工位数据全部来自 ConfigViewModel（同一份），自动测试 / 长期稳定性 / 快速测试共用。
        需要扫码录入的现场场景请走「配置 → 工位」。
    -->
    <UserControl.Resources>
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="62"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="VDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Row0 工具条：布局参数在左，导入/导出/独立编辑在右 ══ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="导入 CSV" Style="{StaticResource GhostButton}" Padding="12,5"
                            Command="{Binding Config.ImportSlotsCommand}"
                            ToolTip="从 CSV 导入工位表（覆盖当前表）"/>
                    <Button Content="导出 CSV" Style="{StaticResource GhostButton}" Padding="12,5" Margin="8,0,0,0"
                            Command="{Binding Config.ExportSlotsCommand}"
                            ToolTip="把当前工位表导出为 CSV"/>
                    <Button Content="独立编辑" Style="{StaticResource GhostButton}" Padding="12,5" Margin="8,0,0,0"
                            Click="OpenSlotsWindow_Click"
                            ToolTip="隐藏主界面，在独立窗口中放大编辑工位表"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="工位数量" Style="{StaticResource ToolLabel}"/>
                    <TextBox Style="{StaticResource NumBox}"
                             Text="{Binding Config.SlotCount, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="改数量会立即按当前布局参数重新生成工位表"/>
                    <!-- 用 PrimaryButton（与配置页的「刷新工位表」同一个蓝），
                         不用 SaveButton —— 绿色在这个界面是「保存」的语义，出现在这排会误导。 -->
                    <Button Content="生成工位表" Style="{StaticResource PrimaryButton}"
                            Padding="12,5" Margin="8,0,0,0"
                            Command="{Binding Config.RegenerateSlotsCommand}"
                            ToolTip="按当前参数重新生成；已手工改过的序列号会尽量保留"/>

                    <Rectangle Style="{StaticResource VDivider}"/>
                    <TextBlock Text="起始编号" Style="{StaticResource ToolLabel}"/>
                    <TextBox Style="{StaticResource NumBox}"
                             Text="{Binding Config.StartIndex, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="第一个工位的编号，例如 1 或 129"/>

                    <Rectangle Style="{StaticResource VDivider}"/>
                    <TextBlock Text="批次号" Style="{StaticResource ToolLabel}"/>
                    <TextBox Style="{StaticResource NumBox}" Width="108"
                             Text="{Binding Config.BatchNo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="写入报表的批次号，例：260826_01"/>

                    <Rectangle Style="{StaticResource VDivider}"/>
                    <CheckBox Content="自动编号" VerticalAlignment="Center"
                              IsChecked="{Binding Config.AutoNumber}"
                              ToolTip="按起始 ID 自动填充序列号"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Row1 工位明细表（占满整宽） ══ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11">
                            <Run Text="共 "/>
                            <Run Text="{Binding Config.PreviewCount, Mode=OneWay}"/>
                            <Run Text=" / 256 行"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="13" Fill="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="工位明细" Style="{StaticResource PanelTitleText}"/>
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       Text="自动测试 / 长期稳定性 / 快速测试共用这一份工位表"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="SlotGrid" ItemsSource="{Binding Config.Slots}" BorderThickness="0"
                          SelectionMode="Single"
                          AutoGenerateColumns="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          FrozenColumnCount="1"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <!-- 不设 RowStyle：配置页那套「绿底 = 已录入 / 琥珀 = 待扫码」是**扫码**语义，
                         这一页没有扫码，全部行都填了自动序列号 → 整片绿底只是噪声。 -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="工位"        Binding="{Binding Slot}"          Width="76"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="序列号"      Binding="{Binding SerialNo}"      Width="220"/>
                        <DataGridTextColumn Header="坐标X"      Binding="{Binding PositionX}"      Width="70"/>
                        <DataGridTextColumn Header="坐标Y"      Binding="{Binding PositionY}"      Width="70"/>
                        <DataGridTextColumn Header="板卡位"      Binding="{Binding Board}"         Width="80"/>
                        <DataGridTextColumn Header="板卡工位号"  Binding="{Binding BoardSlotNo}"   Width="90"/>
                        <DataGridTextColumn Header="夹具位"      Binding="{Binding Fixture}"       Width="70"/>
                        <DataGridTextColumn Header="夹具工位号"  Binding="{Binding FixtureSlotNo}" Width="90"/>
                        <DataGridTextColumn Header="阀位"        Binding="{Binding Valve}"         Width="60"/>
                        <DataGridTextColumn Header="阀门"        Binding="{Binding ValveAddr}"     Width="70"/>
                        <DataGridTextColumn Header="压力控制器"  Binding="{Binding PressureController}" Width="90"/>
                        <DataGridTextColumn Header="数字万用表"  Binding="{Binding Dmm}"           Width="90"/>
                        <DataGridTextColumn Header="通道"        Binding="{Binding Channel}"       Width="70"/>
                        <DataGridTextColumn Header="层数"        Binding="{Binding Layer}"         Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
