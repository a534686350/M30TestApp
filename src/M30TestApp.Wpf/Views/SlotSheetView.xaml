<UserControl x:Class="M30TestApp.Wpf.Views.SlotSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <!-- 真正的电子表格（x-spreadsheet）：单元格选择 / 拖动填充 / Excel 复制粘贴。
         初始化失败（现场没装 WebView2 运行时）时显示提示，不影响程序其它部分。 -->
    <Grid>
        <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />

        <Border x:Name="HintPanel" Background="{DynamicResource CardBgBrush}"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock x:Name="HintTitle" Text="表格控件未就绪"
                           FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="HintText" Margin="0,8,0,0" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
