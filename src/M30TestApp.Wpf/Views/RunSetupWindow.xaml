<Window x:Class="M30TestApp.Wpf.Views.RunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
        xmlns:local="clr-namespace:M30TestApp.Wpf.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:RunSetupViewModel}"
        Title="选择运行方案"
        Width="1180" Height="720" MinHeight="600" MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <!-- 字段标签用正文色而不是灰字：深色下灰字（约 60% 白）在深底上偏暗，
             按 WCAG 的 4.5:1 虽然够，但现场看就是"看不清"。标签很短，提亮不影响层次。 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ── 紧凑排布的字段（标签在左、输入在右，一行一个字段） ── -->
        <Style x:Key="InlineLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style x:Key="InlineNum" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="GroupCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="CompactGroup" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
                <Style x:Key="NumBoxReadonly" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>
            <Style x:Key="InputField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            </Style>
</Window.Resources>

    <DockPanel>
        <!-- ─── Top action bar ─── -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Rectangle Width="3" Height="14" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="选择运行方案" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="应用" Style="{StaticResource PrimaryButton}" Height="28" Padding="16,0"
                            FontSize="12" Command="{Binding ApplyCommand}"/>
                    <Button Content="取消" Style="{StaticResource GhostButton}" Height="28" Padding="16,0"
                            FontSize="12" Margin="8,0,0,0" Command="{Binding CancelCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="SetupTabs" Margin="10">
            <!-- ════════════════════════════════════════════════════════ -->
            <!-- Tab 1: 选择方案 -->
            <!-- ════════════════════════════════════════════════════════ -->
            <TabItem Header="选择方案">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部方案选择：左「方案」下拉 + 右「运行参数」，两块紧邻靠左，
                         不再让方案下拉孤零零挂在最左、中间空一大片。 -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="方案" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding AllPlans}"
                                          SelectedItem="{Binding SelectedPlanDisplay}"
                                          Width="380" HorizontalAlignment="Left"
                                          ToolTip="选择一个方案即加载其全部参数与传感器型号；不再需要单独选型号"/>
                                <TextBlock Text="{Binding PlanSensorType, StringFormat=传感器型号：{0}}"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource FontSizeCaption}"
                                           Margin="0,8,0,0" ToolTip="由所选方案自动带出，无需单独选择"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource HeaderBgBrush}" CornerRadius="6"
                                    Padding="12,8" VerticalAlignment="Top">
                                <StackPanel>
                                    <!-- 采集方式（电路板 / 万用表）已移到「配置 → 系统设置」：
                                         同一套测试系统只有一种采集方式，不该每个方案各选一次。 -->
                                    <TextBlock Text="设备启用" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="压力控制器" IsChecked="{Binding UsePressure}" Margin="0,0,10,0"/>
                                        <CheckBox Content="烘箱" IsChecked="{Binding UseOven}" Margin="0,0,10,0"
                                                  IsEnabled="{Binding OvenRequiredForRun, Converter={StaticResource InverseBoolConverter}}"/>
                                        <CheckBox Content="探漏" IsChecked="{Binding UseLeakCheck}"
                                                  Visibility="{Binding ShowLeakCheckOption, Converter={StaticResource BoolToVis}}"
                                                  ToolTip="保压测泄漏率。万用表采集不控制气路阀门，不做探漏"/>
                                    </StackPanel>
                                    <TextBlock Text="DAQ973A 采集项" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,8,0,4"
                                               Visibility="{Binding ShowLongTermMeasureOptions, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowLongTermMeasureOptions, Converter={StaticResource BoolToVis}}">
                                        <RadioButton Content="电压 (mV)" GroupName="LongTermMeasure"
                                                     IsChecked="{Binding LongTermMeasureVoltage}" Margin="0,0,14,0"/>
                                        <RadioButton Content="电阻 (Ω)" GroupName="LongTermMeasure"
                                                     IsChecked="{Binding LongTermMeasureResistance}"/>
                                    </StackPanel>
                                    <TextBlock Text="采集项启用" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,8,0,4"
                                               Visibility="{Binding ShowCollectionOptions, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowCollectionOptions, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="UT" IsChecked="{Binding CollectUt}" Margin="0,0,10,0"/>
                                        <CheckBox Content="USC" IsChecked="{Binding CollectUsc}" Margin="0,0,10,0"/>
                                        <CheckBox Content="ISC" IsChecked="{Binding CollectIsc}" Margin="0,0,10,0"/>
                                        <CheckBox Content="USG" IsChecked="{Binding CollectUsg}" Margin="0,0,10,0"/>
                                        <CheckBox Content="烘箱温度" IsChecked="{Binding CollectOvenTemp}"/>
                                    </StackPanel>
                                    <!-- 万用表采集：本轮采什么由这里勾 -->
                                    <TextBlock Text="采集项启用" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,8,0,4"
                                               Visibility="{Binding ShowDmmCollectionOptions, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowDmmCollectionOptions, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="电压" IsChecked="{Binding DmmCollectVoltage}" Margin="0,0,10,0"/>
                                        <CheckBox Content="电阻" IsChecked="{Binding DmmCollectResistance}" Margin="0,0,10,0"/>
                                        <CheckBox Content="烘箱温度" IsChecked="{Binding CollectOvenTemp}"/>
                                    </StackPanel>
                                    <!-- 测试回差：3 个压力点 → 5 个采集点（0→50→100→50→0） -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox Content="测试回差" IsChecked="{Binding TestHysteresis}"
                                                  ToolTip="勾选：正向测完后反向降回来再测一遍，3 个压力点变 5 个采集点（多出 Usig50_R / Usig0_R 列）"/>
                                        <TextBlock Text="{Binding TestHysteresisHint}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox Content="从断点续测" IsChecked="{Binding ResumeFromCheckpoint}"
                                              Visibility="{Binding CanResumeCheckpoint, Converter={StaticResource BoolToVis}}"
                                              ToolTip="续测以温度点为单位：从上次未测完的那个温度点的第一个压力点重新测，该温度点已测的数据作废，更早温度点的数据保留"
                                              Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding CheckpointSummary}" TextWrapping="Wrap" FontSize="11.5"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                                               Visibility="{Binding CanResumeCheckpoint, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top"
                                        HorizontalAlignment="Right">
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="压力点" Foreground="#CCFFFFFF" FontSize="11.5"/>
                                        <TextBlock Text="{Binding PlanPressureCount}" Foreground="White" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="温度点" Foreground="#CCFFFFFF" FontSize="11.5"/>
                                        <TextBlock Text="{Binding PlanTempCount}" Foreground="White" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource HeaderBgBrush}" CornerRadius="4" Padding="10,4">
                                    <StackPanel>
                                        <TextBlock Text="精度 (‰)" Foreground="{DynamicResource MutedBrush}" FontSize="11.5"/>
                                        <TextBlock Text="{Binding PlanPrecision}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 详情区 -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <!-- 左栏内容比可视区高（型号/压力单位/测试设备/生成模板/晶圆编号/报表型号/说明），
                                 必须套 ScrollViewer，否则窗口不够高时下面的项直接被裁掉且拖不动。 -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="基础信息" FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeTitle}" Margin="0,0,0,12"/>

                                    <!-- 传感器型号已并入顶部「方案」下拉，这里不再重复显示一个「型号」框
                                         （原来选完方案下面又冒出个「型号 demo」，现场以为没合并成功）。 -->
                                    <TextBlock Text="压力单位" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding PlanPressureUnit, Mode=OneWay}" IsReadOnly="True"/>

                                    <TextBlock Text="默认压力类型" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <TextBox Text="{Binding PlanDefaultPressureType, Mode=OneWay}" IsReadOnly="True"/>

                                    <TextBlock Text="测试设备（报表 AO 列，开测前选择）" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="＋" Width="26" Margin="4,0,0,0"
                                                Style="{StaticResource GhostButton}" Padding="0"
                                                ToolTip="把输入框里的型号加进下拉候选（本次运行有效）"
                                                Click="OnAddReportDevice"/>
                                        <ComboBox IsEditable="True"
                                                  ItemsSource="{Binding ReportDeviceOptions}"
                                                  SelectedItem="{Binding ReportDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Text="{Binding ReportDevice, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="候选来自往期报表 AO 列；没有的型号直接输入即可，本轮测试即时生效。留空则用 Setting.ini 中 [Device.Pressure] Model"/>
                                    </DockPanel>

                                    <TextBlock Text="生成模板" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <ComboBox ItemsSource="{Binding ReportTemplateOptions}"
                                              SelectedItem="{Binding SelectedReportTemplate}"
                                              ToolTip="自动测试模板 = 沿用全性能.xlsx，行为不变；晶圆测试模板 = 用「生成的数据格式」下的现场样例生成，并在桌面另存一份同名 xlsx"/>
                                    <TextBlock Text="{Binding ReportTemplateHint}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="晶圆编号（报表 C 列）" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <TextBox Text="{Binding ReportWaferNo, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="留空 = 自动取序列号去掉末段工位序号，例如 142426-08-01 → 142426-08"/>
                                    <TextBlock Text="{Binding ReportWaferNoHint}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="型号（报表 C 列 + 文件名）" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <TextBox Text="{Binding ReportModel, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="留空 = 自动取方案传感器型号去掉 M30- 前缀"/>
                                    <TextBlock Text="{Binding ReportModelHint}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="说明" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,4"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11.5">
                                        本对话框只在本次启动测试时生效。指定方案 + 重新生成工位表后点击 Apply，
                                        主程序会用新配置开始流水线，不会写回 setting 文件。
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Column="1" Margin="10,0,0,0" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                                    <TextBlock Text="TaskScript 预览" FontWeight="SemiBold"/>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                    <TextBlock Text="{Binding PlanTaskPreview}"
                                               FontFamily="Consolas" FontSize="12"
                                               TextWrapping="NoWrap"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- 工位页签已移除：工位统一在侧边栏「工位表」配置，运行时直接使用。 -->
        </TabControl>
    </DockPanel>
</Window>
