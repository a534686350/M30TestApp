<Window x:Class="M30TestApp.Wpf.Views.RunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
        xmlns:local="clr-namespace:M30TestApp.Wpf.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:RunSetupViewModel}"
        Title="选择运行方案"
        Width="980" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
                <Style x:Key="NumBoxReadonly" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>
            <Style x:Key="InputField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            </Style>
</Window.Resources>

    <DockPanel>
        <!-- ─── Top action bar ─── -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🚀  选择运行方案" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="✓ Apply" Style="{StaticResource PrimaryButton}" Padding="14,4"
                            Command="{Binding ApplyCommand}"/>
                    <Button Content="✕ Cancel" Style="{StaticResource GhostButton}" Padding="14,4" Margin="8,0,0,0"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Margin="10">
            <!-- ════════════════════════════════════════════════════════ -->
            <!-- Tab 1: 选择方案 -->
            <!-- ════════════════════════════════════════════════════════ -->
            <TabItem Header="选择方案">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部方案选择 -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="方案" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding PlanFolders}"
                                          SelectedItem="{Binding SelectedPlanFolder}"
                                          Width="320" HorizontalAlignment="Left"/>
                                <TextBlock Text="传感器型号" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,4"/>
                                <ComboBox ItemsSource="{Binding SensorModels}"
                                          SelectedItem="{Binding SelectedSensorModel}"
                                          Width="320" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource HeaderBgBrush}" CornerRadius="6"
                                    Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Bottom">
                                <StackPanel>
                                    <!-- 自动测试的采集方式：电路板（DAC 逐工位）或万用表（DAQ973A 电压/电阻）。
                                         决定 RunTaskScript 走 Run:PerformanceTest 还是 Run:DmmAutoTest。 -->
                                    <TextBlock Text="采集方式" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4"
                                               Visibility="{Binding ShowAutoTestModeOptions, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                Visibility="{Binding ShowAutoTestModeOptions, Converter={StaticResource BoolToVis}}">
                                        <RadioButton Content="电路板采集" GroupName="AutoTestMode" Margin="0,0,14,0"
                                                     IsChecked="{Binding UseBoardAutoTest}"
                                                     ToolTip="采集板（DAC）逐工位采集 UT / USC / ISC / USG，工位上限 256"/>
                                        <RadioButton Content="万用表采集 (DAQ973A)" GroupName="AutoTestMode"
                                                     IsChecked="{Binding UseDmmAutoTest}"
                                                     ToolTip="{Binding DmmChannelSummary}"/>
                                    </StackPanel>
                                    <TextBlock Text="设备启用" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="压力控制器" IsChecked="{Binding UsePressure}" Margin="0,0,10,0"/>
                                        <CheckBox Content="烘箱" IsChecked="{Binding UseOven}" Margin="0,0,10,0"
                                                  IsEnabled="{Binding OvenRequiredForRun, Converter={StaticResource InverseBoolConverter}}"/>
                                        <CheckBox Content="探漏" IsChecked="{Binding UseLeakCheck}"
                                                  Visibility="{Binding ShowLeakCheckOption, Converter={StaticResource BoolToVis}}"
                                                  ToolTip="保压测泄漏率。万用表采集不控制气路阀门，不做探漏"/>
                                    </StackPanel>
                                    <TextBlock Text="DAQ973A 采集项" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,4"
                                               Visibility="{Binding ShowLongTermMeasureOptions, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowLongTermMeasureOptions, Converter={StaticResource BoolToVis}}">
                                        <RadioButton Content="电压 (mV)" GroupName="LongTermMeasure"
                                                     IsChecked="{Binding LongTermMeasureVoltage}" Margin="0,0,14,0"/>
                                        <RadioButton Content="电阻 (Ω)" GroupName="LongTermMeasure"
                                                     IsChecked="{Binding LongTermMeasureResistance}"/>
                                    </StackPanel>
                                    <TextBlock Text="采集项启用" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,4"
                                               Visibility="{Binding ShowCollectionOptions, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowCollectionOptions, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="UT" IsChecked="{Binding CollectUt}" Margin="0,0,10,0"/>
                                        <CheckBox Content="USC" IsChecked="{Binding CollectUsc}" Margin="0,0,10,0"/>
                                        <CheckBox Content="ISC" IsChecked="{Binding CollectIsc}" Margin="0,0,10,0"/>
                                        <CheckBox Content="USG" IsChecked="{Binding CollectUsg}" Margin="0,0,10,0"/>
                                        <CheckBox Content="烘箱温度" IsChecked="{Binding CollectOvenTemp}"/>
                                    </StackPanel>
                                    <!-- 万用表采集：本轮采什么由这里勾 -->
                                    <TextBlock Text="采集项启用" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,4"
                                               Visibility="{Binding ShowDmmCollectionOptions, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowDmmCollectionOptions, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="电压" IsChecked="{Binding DmmCollectVoltage}" Margin="0,0,10,0"/>
                                        <CheckBox Content="电阻" IsChecked="{Binding DmmCollectResistance}" Margin="0,0,10,0"/>
                                        <CheckBox Content="烘箱温度" IsChecked="{Binding CollectOvenTemp}"/>
                                    </StackPanel>
                                    <CheckBox Content="从断点续测" IsChecked="{Binding ResumeFromCheckpoint}"
                                              Visibility="{Binding CanResumeCheckpoint, Converter={StaticResource BoolToVis}}"
                                              Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding CheckpointSummary}" TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                                               Visibility="{Binding CanResumeCheckpoint, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="压力点" Foreground="#CCFFFFFF" FontSize="11"/>
                                        <TextBlock Text="{Binding PlanPressureCount}" Foreground="White" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="温度点" Foreground="#CCFFFFFF" FontSize="11"/>
                                        <TextBlock Text="{Binding PlanTempCount}" Foreground="White" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource HeaderBgBrush}" CornerRadius="4" Padding="10,4">
                                    <StackPanel>
                                        <TextBlock Text="精度 (‰)" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding PlanPrecision}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 详情区 -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <!-- 左栏内容比可视区高（型号/压力单位/测试设备/生成模板/晶圆编号/报表型号/说明），
                                 必须套 ScrollViewer，否则窗口不够高时下面的项直接被裁掉且拖不动。 -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="基础信息" FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeTitle}" Margin="0,0,0,12"/>

                                    <TextBlock Text="型号" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBox Text="{Binding PlanSensorType, Mode=OneWay}" IsReadOnly="True"/>

                                    <TextBlock Text="压力单位" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <TextBox Text="{Binding PlanPressureUnit, Mode=OneWay}" IsReadOnly="True"/>

                                    <TextBlock Text="默认压力类型" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <TextBox Text="{Binding PlanDefaultPressureType, Mode=OneWay}" IsReadOnly="True"/>

                                    <TextBlock Text="测试设备（报表 AO 列，开测前选择）" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="＋" Width="26" Margin="4,0,0,0"
                                                Style="{StaticResource GhostButton}" Padding="0"
                                                ToolTip="把输入框里的型号加进下拉候选（本次运行有效）"
                                                Click="OnAddReportDevice"/>
                                        <ComboBox IsEditable="True"
                                                  ItemsSource="{Binding ReportDeviceOptions}"
                                                  Text="{Binding ReportDevice, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="候选来自往期报表 AO 列；没有的型号直接输入即可，本轮测试即时生效。留空则用 Setting.ini 中 [Device.Pressure] Model"/>
                                    </DockPanel>

                                    <TextBlock Text="生成模板" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <ComboBox ItemsSource="{Binding ReportTemplateOptions}"
                                              SelectedItem="{Binding SelectedReportTemplate}"
                                              ToolTip="自动测试模板 = 沿用全性能.xlsx，行为不变；晶圆测试模板 = 用「生成的数据格式」下的现场样例生成，并在桌面另存一份同名 xlsx"/>
                                    <TextBlock Text="{Binding ReportTemplateHint}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="晶圆编号（报表 C 列）" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <TextBox Text="{Binding ReportWaferNo, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="留空 = 自动取序列号去掉末段工位序号，例如 142426-08-01 → 142426-08"/>
                                    <TextBlock Text="{Binding ReportWaferNoHint}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="型号（报表 C 列 + 文件名）" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
                                    <TextBox Text="{Binding ReportModel, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="留空 = 自动取方案传感器型号去掉 M30- 前缀"/>
                                    <TextBlock Text="{Binding ReportModelHint}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="说明" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,4"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11">
                                        本对话框只在本次启动测试时生效。指定方案 + 重新生成工位表后点击 Apply，
                                        主程序会用新配置开始流水线，不会写回 setting 文件。
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Column="1" Margin="10,0,0,0" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                                    <TextBlock Text="TaskScript 预览" FontWeight="SemiBold"/>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                    <TextBlock Text="{Binding PlanTaskPreview}"
                                               FontFamily="Consolas" FontSize="12"
                                               TextWrapping="NoWrap"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- Tab 2: 工位 -->
            <!-- ════════════════════════════════════════════════════════ -->
            <TabItem Header="工位">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 参数 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- 长期稳定性：起止工位 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Visibility="{Binding ShowLongTermSlotLayout, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="8,0">
                                    <TextBlock Text="起始工位" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource InputField}" Text="{Binding StartIndex, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0">
                                    <TextBlock Text="结束工位" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource NumBox}"
                                             Text="{Binding EndIndex, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0">
                                    <TextBlock Text="工位数量" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource NumBoxReadonly}" Text="{Binding SlotCount, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0" VerticalAlignment="Bottom">
                                    <TextBlock Text="DAQ通道(自动)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource NumBoxReadonly}" Text="{Binding StartChannel, Mode=OneWay}" Width="72"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding LongTermSlotRangeHint}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                       Visibility="{Binding ShowLongTermSlotLayout, Converter={StaticResource BoolToVis}}"/>

                            <!-- 自动测试 / 板卡模式：按现场排查顺序分组 -->
                            <Grid Visibility="{Binding ShowLegacySlotLayoutFields, Converter={StaticResource BoolToVis}}"
                                  Margin="0,2,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="1.55*"/>
                                    <ColumnDefinition Width="1.35*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource HeaderBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="8" Margin="0,0,6,6">
                                    <StackPanel>
                                        <TextBlock Text="工位范围" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,7"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="所需工位" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource InputField}" Text="{Binding SlotCount, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="起始编号" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource NumBox}"
                                                         Text="{Binding StartIndex, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="{DynamicResource HeaderBgBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        Padding="8" Margin="0,0,6,6"
                                        Visibility="{Binding ShowBoardLayoutFields, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="板卡映射" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,7"/>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,4,5">
                                                <TextBlock Text="起始板卡" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource NumBox}"
                                                         Text="{Binding StartBoard, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,5">
                                                <TextBlock Text="起始板卡工位" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource NumBox}"
                                                         Text="{Binding StartBoardSlot, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Margin="0,0,4,0">
                                                <TextBlock Text="每块板卡工位数" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource NumBox}"
                                                         Text="{Binding BoardSlotCapacity, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom"
                                                       Margin="4,0,0,4" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="{Binding BoardMappingSummary}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 万用表采集：板卡映射无意义，改显示 973 通道组 -->
                                <Border Grid.Column="1" Background="{DynamicResource AccentLightBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        Padding="8" Margin="0,0,6,6"
                                        Visibility="{Binding UseDmmAutoTest, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="DAQ973A 通道" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,7"/>
                                        <TextBlock Text="{Binding DmmChannelSummary}" FontSize="11"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource HeaderBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="夹具 / 阀位 / 通道" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,7"/>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,4,5">
                                                <TextBlock Text="起始阀位（按工位自动）" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource NumBox}"
                                                         Text="{Binding StartValve, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,5">
                                                <TextBlock Text="单个夹具工位" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource NumBox}"
                                                         Text="{Binding FixtureSlotCapacity, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Margin="0,0,4,0">
                                                <TextBlock Text="夹具数量" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource NumBox}"
                                                         Text="{Binding FixtureCount, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="万用表起始通道" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Style="{StaticResource NumBox}"
                                                         Text="{Binding StartChannel, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.ColumnSpan="3"
                                        Background="{DynamicResource AccentLightBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        Padding="8,5" Margin="0,0,0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BoardMappingSummary}" FontSize="11"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding ValveRangeHint}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock HorizontalAlignment="Right" Margin="0,8,0,0"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11">
                                <Run Text="工位上限"/>
                                <Run Text="{Binding SlotLimit, Mode=OneWay}"/>
                                <Run Text=" · 当前预览"/>
                                <Run Text="{Binding PreviewCount, Mode=OneWay}"/>
                                <Run Text="行"/>
                            </TextBlock>
                            <TextBlock Text="{Binding ChannelHint}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       Visibility="{Binding ShowChannelHint, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,10,0,0" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="扫码录入:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="当前工位" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="RunScanSlotLabel" Text="-" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                            <TextBox x:Name="RunBarcodeInput" Width="260" Padding="6,4"
                                     AcceptsReturn="False"
                                     PreviewKeyDown="OnRunBarcodeKeyDown"
                                     TextChanged="OnRunBarcodeTextChanged"
                                     InputMethod.IsInputMethodEnabled="False"
                                     ToolTip="点击此处，然后用扫码枪扫描条码（回车确认并跳到下一工位）"/>
                            <Button Content="确认" Style="{StaticResource GhostButton}" Padding="10,3" Margin="6,0"
                                    Click="OnRunBarcodeConfirm"/>
                            <TextBlock x:Name="RunScanStatusText" Text="" VerticalAlignment="Center"
                                       Foreground="Green" Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- 预览表 -->
                    <Border Style="{StaticResource Card}" Grid.Row="2" Margin="0,10,0,0" Padding="0">
                        <DataGrid x:Name="RunSlotGrid" ItemsSource="{Binding PreviewSlots}" BorderThickness="0"
                                  SelectionMode="Single"
                                  AutoGenerateColumns="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  IsReadOnly="False"
                                  SelectionChanged="OnRunSlotGridSelectionChanged">
                            <!-- 与 ConfigView 工位页同一套扫码语义：已录入绿底 / 未录入透明 / 当前待扫行琥珀。
                                 录入哪一行，哪一行就有底色反馈；不要靠选中色，选中色会盖掉底色。 -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{DynamicResource ScannedRowBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SerialNo}" Value="">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NextRowBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="工位"        Binding="{Binding Slot}"          Width="70"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="序列号"      Binding="{Binding SerialNo}"      Width="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="坐标X"      Binding="{Binding PositionX}"      Width="70"/>
                                <DataGridTextColumn Header="坐标Y"      Binding="{Binding PositionY}"      Width="70"/>
                                <DataGridTextColumn Header="板卡位"      Binding="{Binding Board}"         Width="80"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="板卡工位号"  Binding="{Binding BoardSlotNo}"   Width="90"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="夹具位"      Binding="{Binding Fixture}"       Width="70"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="夹具工位号"  Binding="{Binding FixtureSlotNo}" Width="90"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="阀位"        Binding="{Binding Valve}"         Width="60"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="阀门"        Binding="{Binding ValveAddr}"     Width="70"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="压力控制器"  Binding="{Binding PressureController}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="数字万用表"  Binding="{Binding Dmm}"           Width="90"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="通道"        Binding="{Binding Channel}"       Width="70"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="层数"        Binding="{Binding Layer}"         Width="60"  IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- 底部刷新条 -->
                    <Border Grid.Row="3" Background="{DynamicResource HeaderBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Margin="0,10,0,0" Padding="12,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="批次号" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource InputField}" Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="6,0,16,0"/>
                                <TextBlock Text="起始ID" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource InputField}" Text="{Binding StartSerial, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="6,0,16,0"/>
                                <CheckBox Content="自动编号" IsChecked="{Binding AutoNumber}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="🔄 刷新" Style="{StaticResource PrimaryButton}"
                                    Padding="14,4" Command="{Binding RegenerateCommand}"
                                    HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
