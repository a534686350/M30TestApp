<UserControl x:Class="M30TestApp.Wpf.Views.QuickTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:QuickTestViewModel}"
             mc:Ignorable="d">
    <!--
        快速测试页 v2（2026-10-29 重排）—— 与配置页 / 手动页同一套规范：
        参数条 → 左「控制器与判定指标」+ 右「工位结果表」→ 测试日志 → 说明。
        原来参数条是一整块直角 Card，字段宽度各异、单位下拉窄到显示成「kP」、
        左卡 260px 里塞两块内容、日志区高度 140 却常常是空白。
    -->
    <UserControl.Resources>
        <Style x:Key="QuickResultCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TestResult}" Value="pass">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TestResult}" Value="fail">
                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickFailedCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TestResult}" Value="fail">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickBtn" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="QuickBtnPrimary" TargetType="Button" BasedOn="{StaticResource SaveButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 卡片内分组标题：主题里没有这个键（其它页各自定义），本页自己带一份 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="80"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="140" MinHeight="90"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row0 参数条：压力点 · 控压参数 · 工位范围 ‖ 状态 + 操作 ═══ -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ① 压力点 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <StackPanel Width="96" Margin="0,0,8,0">
                        <TextBlock Text="P0" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding P0, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="96" Margin="0,0,8,0">
                        <TextBlock Text="P50" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding P50, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="96" Margin="0,0,8,0">
                        <TextBlock Text="P100" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding P100, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="104">
                        <TextBlock Text="单位" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding PressureUnits}"
                                  Text="{Binding PressureUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{DynamicResource DividerBrush}" Margin="12,2"/>

                <!-- ② 控压参数 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0">
                    <StackPanel Width="92" Margin="0,0,8,0">
                        <TextBlock Text="压力精度" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PressurePrecision, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="80">
                        <TextBlock Text="保压 (s)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding HoldSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="3" Fill="{DynamicResource DividerBrush}" Margin="12,2"/>

                <!-- ③ 工位范围 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0">
                    <StackPanel Width="84" Margin="0,0,8,0">
                        <TextBlock Text="起始工位" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding StartSlot, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="84">
                        <TextBlock Text="结束工位" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EndSlot, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ④ 方案 / 状态 -->
                <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Margin="16,0,12,6">
                    <TextBlock Text="{Binding SensorName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="{StaticResource FontSizeSmall}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- ⑤ 操作 -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="刷新工位" Style="{StaticResource QuickBtn}" MinWidth="84"
                            Command="{Binding RefreshSlotsCommand}"/>
                    <Button Content="开始快速测试" Style="{StaticResource QuickBtnPrimary}" MinWidth="112"
                            Margin="8,0,0,0" Command="{Binding StartCommand}"/>
                    <Button Content="停止" Style="{StaticResource QuickBtn}" MinWidth="64"
                            Margin="8,0,0,0" Command="{Binding StopCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Row1 左：控制器与判定指标 ｜ 右：工位结果表 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelCard}" Grid.Column="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                        <TextBlock Text="压力控制器 / 判定指标" Style="{StaticResource PanelTitleText}"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,10,12,12">
                            <TextBlock Text="型号" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding PressureModels}"
                                      Text="{Binding PressureModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="端口" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PressurePorts}"
                                              Text="{Binding PressurePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="地址" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PressureAddrs}"
                                              Text="{Binding PressureAddr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,12"/>

                            <TextBlock Text="判定指标" Style="{StaticResource GroupTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="测试前录入，留空表示不限。"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource FontSizeCaption}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="Span Min / Max" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SpanMin, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1" Text="~" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Grid.Column="2" Text="{Binding SpanMax, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Text="Linearity / NL Min / Max" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding LinearityMin, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1" Text="~" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Grid.Column="2" Text="{Binding LinearityMax, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}" Grid.Column="2">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="工位结果" Style="{StaticResource PanelTitleText}"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource FontSizeCaption}"
                                       Text="{Binding Status}"/>
                        </DockPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="工位" Binding="{Binding Slot}" Width="80"/>
                            <DataGridTextColumn Header="序列号" Binding="{Binding SerialNo}" Width="130"/>
                            <DataGridTextColumn Header="板卡位" Binding="{Binding Board}" Width="70"/>
                            <DataGridTextColumn Header="板卡工位号" Binding="{Binding BoardSlotNo}" Width="90"/>
                            <DataGridTextColumn Header="Usig P0" Binding="{Binding P0}" Width="95"/>
                            <DataGridTextColumn Header="Usig P50" Binding="{Binding P50}" Width="95"/>
                            <DataGridTextColumn Header="Usig P100" Binding="{Binding P100}" Width="95"/>
                            <DataGridTextColumn Header="Span" Binding="{Binding Span}" Width="90"/>
                            <DataGridTextColumn Header="NL" Binding="{Binding Linearity}" Width="90"/>
                            <DataGridTextColumn Header="不合格指标" Binding="{Binding FailedMetrics}" Width="*"
                                                CellStyle="{StaticResource QuickFailedCellStyle}"/>
                            <DataGridTextColumn Header="测试结果" Binding="{Binding TestResult}" Width="100"
                                                CellStyle="{StaticResource QuickResultCellStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ Row2 测试日志 ═══ -->
        <Border Style="{StaticResource PanelCard}" Grid.Row="2" Margin="0,10,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="测试日志" Style="{StaticResource PanelTitleText}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource FontSizeCaption}"/>
                    </DockPanel>
                </Border>
                <TextBox x:Name="QuickLogTextBox"
                         Text="{Binding LogText, Mode=OneWay}"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="{StaticResource FontSizeSmall}"
                         Background="{DynamicResource SurfaceBrush}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="10,4"
                         TextChanged="QuickLogTextBox_TextChanged"/>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource FontSizeCaption}"
                   Text="快速测试只控制压力并采集 Usig；不执行烘箱、UT、Usource、Isource 和完整流程。"/>
    </Grid>
</UserControl>
