<Window x:Class="M30TestApp.Wpf.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="面板" Width="1120" Height="680" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource TopBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="TitleText" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleFgBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource GhostButton}"
                        Width="72" Height="30" Click="Close_Click" ToolTip="关闭窗口返回主界面"/>
            </DockPanel>
        </Border>
        <ContentControl x:Name="PanelHost"/>
    </DockPanel>
</Window>
