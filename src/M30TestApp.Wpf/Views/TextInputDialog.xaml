<Window x:Class="M30TestApp.Wpf.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
        <TextBox x:Name="InputBox" Padding="6,5" KeyDown="OnKeyDown"/>
        <TextBlock x:Name="HintText" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="84" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="确定" Width="84" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
