<UserControl x:Class="M30TestApp.Wpf.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:LogViewModel}"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Margin="12">
        <Border Style="{StaticResource PanelCard}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Rectangle Width="3" Height="12" Fill="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="运行日志" Style="{StaticResource PanelTitleText}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource GhostButton}"
                                Padding="10,1" Command="{Binding ClearCommand}"/>
                    </DockPanel>
                </Border>
                <TextBox x:Name="LogTextBox" Text="{Binding Buffer.Text, Mode=OneWay}" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"
                         Background="{StaticResource SurfaceBrush}"
                         IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="10,4"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
