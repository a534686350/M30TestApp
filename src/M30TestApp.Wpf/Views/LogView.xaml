<UserControl x:Class="M30TestApp.Wpf.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:LogViewModel}"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Margin="12">
        <Border Style="{StaticResource PanelCard}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Rectangle Width="3" Height="12" Fill="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="运行日志" Style="{StaticResource PanelTitleText}"/>
                            <TextBlock Text="{Binding CountText}" Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource GhostButton}"
                                Padding="10,1" Command="{Binding ClearCommand}"/>
                    </DockPanel>
                </Border>

                <!-- 工具条：关键字过滤 + 快捷打开目录（原来整页只有一个「清空」，太单薄） -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBodyBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="过滤" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                        <TextBox Width="260" Padding="8,3" VerticalAlignment="Center"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 ToolTip="关键字过滤（匹配时间 / 级别 / 来源 / 正文），留空显示全部"/>
                        <Button Content="打开日志目录" Style="{StaticResource GhostButton}"
                                Padding="10,3" Margin="10,0,0,0" Command="{Binding OpenLogDirCommand}"/>
                        <Button Content="打开数据目录" Style="{StaticResource GhostButton}"
                                Padding="10,3" Margin="6,0,0,0" Command="{Binding OpenDataDirCommand}"/>
                    </StackPanel>
                </Border>

                <TextBox x:Name="LogTextBox" Text="{Binding Buffer.Text, Mode=OneWay}" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"
                         Background="{DynamicResource SurfaceBrush}"
                         IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="10,4"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
