<UserControl x:Class="M30TestApp.Wpf.Views.TestRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
             xmlns:views="clr-namespace:M30TestApp.Wpf.Views"
             xmlns:conv="clr-namespace:M30TestApp.Wpf.Converters"
             d:DataContext="{d:DesignInstance vm:TestRunViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="OnViewLoaded"
             SizeChanged="OnViewSizeChanged">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="BoolToVisInv"/>
        <Style x:Key="KpiChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

<!-- ────────── Row 0: KPI strip ────────── -->
        <!-- 紧凑横条：色条 + 标签 + 数值，按内容宽度排列。
             原先是 6 张 * 平分的大卡片，1440 宽下每张 ~230px、内容只占 ~90px，右侧全是留白。 -->
        <Grid x:Name="KpiRow" Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

<Border Style="{StaticResource KpiChip}" Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5"
                               Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="工位总数" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding TotalSlots}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
<Border Style="{StaticResource KpiChip}" Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5"
                               Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="合格" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding OkCount}" Style="{StaticResource KpiValue}" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>
<Border Style="{StaticResource KpiChip}" Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5"
                               Fill="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="警告" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding WarnCount}" Style="{StaticResource KpiValue}" Foreground="{StaticResource WarnBrush}"/>
                </StackPanel>
            </Border>
<Border Style="{StaticResource KpiChip}" Grid.Column="3">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5"
                               Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="异常" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding ErrCount}" Style="{StaticResource KpiValue}" Foreground="{StaticResource ErrorBrush}"/>
                </StackPanel>
            </Border>
<Border Style="{StaticResource KpiChip}" Grid.Column="4">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5"
                               Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="温度点" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding CurrentT}" Style="{StaticResource KpiValue}" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
<Border Style="{StaticResource KpiChip}" Grid.Column="5" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5"
                               Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="压力点" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding CurrentP}" Style="{StaticResource KpiValue}" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ────────── Row 1: control bar ────────── -->
        <Border x:Name="ControlBar" Style="{StaticResource Card}" Grid.Row="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 测试类型与当前工步已在顶部命令条显示，这里不再重复，只保留本页特有信息。 -->
                <StackPanel Orientation="Vertical">
                    <WrapPanel>
                        <TextBlock Text="测试方案：" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding PlanName}" FontWeight="SemiBold" Margin="4,0,16,0"/>
                        <TextBlock Text="状态：" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="4,0,16,0"/>
                        <TextBlock Text="耗时：" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding Elapsed}" FontFamily="Consolas" FontWeight="SemiBold" Margin="4,0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding LastError}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentValue, Mode=OneWay}"
                                 Width="220" Height="8" Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource HeaderBgBrush}" BorderThickness="0"/>
                    <TextBlock Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas">
                        <Run Text="{Binding ProgressIndex}"/> / <Run Text="{Binding ProgressTotal}"/>
                    </TextBlock>
                </StackPanel>

                <!-- 主操作（开始 / 停止）统一放在顶部命令条，这里只留本页特有的过程控制，
                     免得同一页出现两组「开始 / 停止」，操作员会犹豫点哪个。 -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="{Binding PauseButtonText}" Style="{StaticResource GhostButton}"
                            Command="{Binding PauseCommand}" MinWidth="76"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ────────── 工作区：左侧采集矩阵 + 右侧栏（测试统计 / 实时日志） ────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightRailColumn" Width="480"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="3" Height="12" Fill="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding MatrixTitle}" Style="{StaticResource PanelTitleText}"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <views:LongTermMatrixGrid Rows="{Binding Rows}"
                                                  LongTermColumns="{Binding LongTermColumns}"
                                                  Visibility="{Binding IsLongTermStabilityMode, Converter={StaticResource BoolToVis}}"/>
                        <views:DataMatrixGrid Rows="{Binding Rows}"
                                              MatrixColumns="{Binding MatrixColumns}"
                                              Visibility="{Binding IsLongTermStabilityMode, Converter={StaticResource BoolToVisInv}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="10,0,0,0">
            <!-- ────────── 右栏下：实时日志 ────────── -->
            <Border x:Name="LiveLogPanel" Style="{StaticResource PanelCard}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Rectangle Width="3" Height="12" Fill="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="实时日志" Style="{StaticResource PanelTitleText}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="清空显示" Style="{StaticResource GhostButton}"
                                Padding="10,1" Command="{Binding ClearLogCommand}"/>
                    </DockPanel>
                </Border>
                <TextBox x:Name="LogTextBox" Text="{Binding Log.Text, Mode=OneWay}" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"
                         Background="{StaticResource SurfaceBrush}"
                         IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="10,4"/>
            </DockPanel>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
