<UserControl x:Class="M30TestApp.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
             xmlns:local="clr-namespace:M30TestApp.Wpf.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 本页是独立窗口，取不到 MainWindow 里的资源 —— 用到的样式必须在本地定义，
             否则 {StaticResource} 会在运行时抛「找不到资源」直接崩页。 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <!-- 站点标识卡片的字段标签：用正文色，深色下更清楚 -->
        <Style x:Key="StationLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="{DynamicResource Settings.Title}"
                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   Margin="4,0,0,16"/>

        <!-- Tab control -->
        <TabControl Grid.Row="1">
            <!-- ═══════ 通用 ═══════ -->
            <TabItem Header="{DynamicResource Settings.Tab.General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8">
                    <StackPanel Margin="0,8,0,0">

                        <!-- Section: General -->
                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0"
                                Padding="12,0" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Settings.Tab.General}"
                                       FontSize="15" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Language -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,2" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Language}"
                                               FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource Settings.Language.Desc}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="160"
                                          SelectedValue="{Binding Language}" SelectedValuePath="Tag"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="{DynamicResource Language.zhCN}" Tag="zh-CN"/>
                                    <ComboBoxItem Content="{DynamicResource Language.enUS}" Tag="en-US"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Theme -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,2" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Theme}"
                                               FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource Settings.Theme.Desc}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="160"
                                          SelectedValue="{Binding Theme}" SelectedValuePath="Tag"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="{DynamicResource Theme.Light}" Tag="Light"/>
                                    <ComboBoxItem Content="{DynamicResource Theme.Dark}" Tag="Dark"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Debug mode -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,2" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="调试模式"
                                               FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="开启后不连接真实硬件，所有指令只记录发送并模拟接收。"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Content="启用"
                                          IsChecked="{Binding DebugMode}"
                                          VerticalAlignment="Center"
                                          Margin="16,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- ═══ 站点标识：给本机录唯一 ID，绑定到总控制台 ═══ -->
                        <Border Style="{StaticResource Card}" Margin="0,2,0,2" Padding="20,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="站点标识（上报总控制台）" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="给本机录一个唯一 ID 并绑定控制台，就能在总控制台上统一看到各台设备的状态。只上报运行状态，不接受任何远程控制；填不全或关掉开关都不影响测试运行。"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="启用上报" VerticalAlignment="Top"
                                              Margin="16,2,0,0" IsChecked="{Binding StationEnabled}"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="站点 ID" Style="{StaticResource StationLabel}" Margin="0,0,8,8"/>
                                    <TextBox Grid.Column="1" Margin="0,0,16,8"
                                             Text="{Binding StationId, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="本机唯一标识，例如 M30-A01（车间+工位号）。控制台靠它区分设备。"/>

                                    <TextBlock Grid.Column="2" Text="显示名称" Style="{StaticResource StationLabel}" Margin="0,0,8,8"/>
                                    <TextBox Grid.Column="3" Margin="0,0,0,8"
                                             Text="{Binding StationName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="控制台上显示的名字，例如「1号台(自动测试)」。留空则显示站点 ID。"/>

                                    <TextBlock Grid.Row="1" Text="控制台地址" Style="{StaticResource StationLabel}" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"
                                             Text="{Binding StationHubUrl, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="例如 http://54.206.27.158/"/>

                                    <TextBlock Grid.Row="2" Text="上报令牌" Style="{StaticResource StationLabel}" Margin="0,0,8,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,16,0"
                                             Text="{Binding StationToken, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="要和服务器上的 M30_HUB_TOKEN 一致；服务器没设令牌就留空。"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="间隔(秒)" Style="{StaticResource StationLabel}" Margin="0,0,8,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="3"
                                             Text="{Binding StationIntervalSec, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="多久上报一次，最小 5 秒。"/>
                                </Grid>

                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Content="保存站点标识"
                                            Style="{StaticResource PrimaryButton}" Padding="16,6"
                                            Command="{Binding SaveStationCommand}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StationSummary}" FontSize="12.5"
                                                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StationStatusText}" FontSize="11.5" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════ 设备 ═══════ -->
            <TabItem Header="设备">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8">
                    <StackPanel Margin="0,8,0,0">

                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0"
                                Padding="12,0" Margin="0,0,0,16">
                            <TextBlock Text="设备配置" FontSize="15" FontWeight="SemiBold"/>
                        </Border>

                        <!-- DAQ973A 台数：决定万用表自动测试的工位上限 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DAQ973A 台数" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding DeviceConfig.DmmUnitHint}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="120" VerticalAlignment="Center"
                                          SelectedValue="{Binding DeviceConfig.DmmUnitCount}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="1 台" Tag="1"/>
                                    <ComboBoxItem Content="2 台" Tag="2"/>
                                    <ComboBoxItem Content="3 台" Tag="3"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- 全部设备地址表 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0">
                            <DataGrid ItemsSource="{Binding DeviceConfig.Rows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0" Background="Transparent"
                                      RowHeight="34">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="设备" Binding="{Binding Title}" Width="130" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="启用" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding IsKindFirst, Converter={StaticResource BoolToVis}}"
                                                          ToolTip="同类设备共用后端开关：勾选=接真实硬件，取消=走模拟"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="型号"
                                                        Binding="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="150"/>
                                    <DataGridTemplateColumn Header="总线 / 串口" Width="105">
    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding BusOptions}"
                                      SelectedItem="{Binding Bus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="6,1" ToolTip="GPIB 设备选总线（GPIB0/1/…），串口设备选 COM 口"/>
                        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="地址号" Width="72"
                                Binding="{Binding Number, UpdateSourceTrigger=PropertyChanged}"/>
<DataGridTextColumn Header="完整地址" Binding="{Binding AddressPreview}"
                                Width="*" IsReadOnly="True"
                                Foreground="{DynamicResource MutedBrush}"/>
                                    <DataGridTextColumn Header="波特率"
                                                        Binding="{Binding Baud, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="用途" Binding="{Binding Hint}" Width="200" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 万用表通道分配：现场可改哪组采电压 / 采电阻 / 切工位电源 / 总电源 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Rectangle Width="3" Height="13" Fill="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="万用表通道分配（DAQ973A）" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,0,2">
                                        <TextBlock Text="每台工位数" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DeviceConfig.DmmSlotsPerUnit, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="电压起始" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DeviceConfig.VoltageStart, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="电阻起始" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DeviceConfig.ResistanceStart, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="工位电源起始" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DeviceConfig.PowerSwitchStart, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="总电源通道" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DeviceConfig.MasterChannels, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="多个通道用逗号分隔；上电时同时闭合"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="9" VerticalAlignment="Bottom" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding DeviceConfig.DmmChannelHint}"
                                                   Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="✓ 保存并应用" Style="{StaticResource PrimaryButton}" Padding="16,5"
                                    Command="{Binding SaveDevicesCommand}"/>
                            <Button Content="↻ 重新读取" Style="{StaticResource GhostButton}" Padding="16,5" Margin="8,0,0,0"
                                    Command="{Binding ReloadDevicesCommand}"/>
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="4,0,0,0">
                            保存后立即按新配置重建设备，不需要重启。DAQ973A 每台管「每台工位数」个工位（默认 16），
                            台数与通道都在上面配，3 台默认合计 48 工位。调试模式开启时全部设备走模拟后端，忽略这里的地址。
                            本页与「配置 → 设备」是同一份数据，改哪边都一样。
                        </TextBlock>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════ 关于 ═══════ -->
            <TabItem Header="{DynamicResource Settings.Tab.About}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" Margin="0,32,0,0" MaxWidth="600">

                        <!-- Logo -->
                        <Border Width="72" Height="72" CornerRadius="18"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF38BDF8" Offset="0"/>
                                    <GradientStop Color="#FF3B82F6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4"
                                                  Direction="270" Color="#4038BDF8" Opacity="0.5"/>
                            </Border.Effect>
                            <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- App name -->
                        <TextBlock Text="{DynamicResource App.Name}" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Settings.About.Desc}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,6,0,16"/>

                        <!-- Version + Check update -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Border Background="{DynamicResource HeaderBgBrush}" CornerRadius="12"
                                    Padding="12,5" Margin="4,0">
                                <TextBlock FontSize="12">
                                    <Run Text="v"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Padding="12,5"
                                    Command="{Binding CheckUpdateCommand}"
                                    IsEnabled="{Binding IsCheckingUpdate, Converter={x:Static local:InverseBoolConverter.Instance}}">
                                <TextBlock FontSize="12">
                                    <Run Text="↻ "/><Run Text="{DynamicResource Settings.CheckUpdate}"/>
                                </TextBlock>
                            </Button>
                        </StackPanel>

                        <!-- 回退到上一版本（升级时自动备份后才显示） -->
                        <Button Style="{StaticResource GhostButton}" Padding="12,6"
                                HorizontalAlignment="Center" Margin="0,0,0,18"
                                Command="{Binding RollbackCommand}"
                                ToolTip="将程序替换为上次升级前的版本；设置与测试数据不受影响"
                                Visibility="{Binding RollbackVersionText, Converter={x:Static local:NonEmptyToVisibleConverter.Instance}}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource WarnBrush}">
                                <Run Text="⏪ 回退到上一版本 "/><Run Text="{Binding RollbackVersionText, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Button>

                        <!-- Update status -->
                        <Border Background="{DynamicResource HeaderBgBrush}" CornerRadius="8"
                                Padding="14,10" Margin="0,0,0,24"
                                Width="360"
                                Visibility="{Binding UpdateStatus, Converter={x:Static local:NonEmptyToVisibleConverter.Instance}}">
                            <StackPanel>
                                <TextBlock Text="{Binding UpdateStatus}" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                             Height="8" Margin="0,8,0,0"
                                             IsIndeterminate="{Binding IsUpdateIndeterminate}"/>
                            </StackPanel>
                        </Border>

                        <!-- Info cards (2x2 grid) -->
                        <UniformGrid Columns="2" Margin="0,0,0,24">
                            <!-- Author -->
                            <Border Style="{StaticResource Card}" Margin="4" Padding="20,18"
                                    HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Settings.Author}"
                                               FontWeight="SemiBold" FontSize="14"
                                               HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                    <TextBlock Text="M30" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Repo -->
                            <Border Style="{StaticResource Card}" Margin="4" Padding="20,18"
                                    HorizontalAlignment="Stretch" Cursor="Hand"
                                    MouseLeftButtonUp="OnOpenRepo">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Settings.Repo}"
                                               FontWeight="SemiBold" FontSize="14"
                                               HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                    <TextBlock Text="{DynamicResource App.Name}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="12" HorizontalAlignment="Center"
                                               TextDecorations="Underline"/>
                                </StackPanel>
                            </Border>

                            <!-- Feedback -->
                            <Border Style="{StaticResource Card}" Margin="4" Padding="20,18"
                                    HorizontalAlignment="Stretch" Cursor="Hand"
                                    MouseLeftButtonUp="OnOpenIssues">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💬" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Settings.Feedback}"
                                               FontWeight="SemiBold" FontSize="14"
                                               HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                    <TextBlock Text="{DynamicResource Settings.Feedback.Desc}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- GitHub link display -->
                            <Border Style="{StaticResource Card}" Margin="4" Padding="20,18"
                                    HorizontalAlignment="Stretch" Cursor="Hand"
                                    MouseLeftButtonUp="OnOpenRepo">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔗" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="GitHub" FontWeight="SemiBold" FontSize="14"
                                               HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                    <TextBlock Text="打开 GitHub"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="12" HorizontalAlignment="Center"
                                               TextDecorations="Underline"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
