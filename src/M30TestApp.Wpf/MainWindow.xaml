<Window x:Class="M30TestApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
        xmlns:conv="clr-namespace:M30TestApp.Wpf.Converters"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        mc:Ignorable="d"
        Title="{DynamicResource App.Title}"
        Icon="/app.ico"
        Height="820" Width="1440"
        MinHeight="640" MinWidth="1080"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:NavKeyIsConverter x:Key="NavKeyIs"/>

        <!-- 横幅上的信息胶囊 -->
        <Style x:Key="BannerChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BannerChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BannerChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleSubBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <Style x:Key="StatusLedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row0 顶部横幅：品牌 | 工位/版本 | 运行状态 · 报警 · 时钟 ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="12,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="4" Height="20" Fill="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="M30 压力传感器自动测试系统"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TitleFgBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Style="{StaticResource BannerChip}" Margin="10,0,0,0">
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource BannerChipText}"/>
                    </Border>
                    <Border Style="{StaticResource BannerChip}" Margin="6,0,0,0">
                        <TextBlock Text="{Binding StationTitle, StringFormat=工位 · {0}}"
                                   Style="{StaticResource BannerChipText}"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource BannerChip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource LedOnBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentRunStatus}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource BannerChip}" Background="{DynamicResource BannerAlarmBrush}"
                            Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource LedErrorBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TestRun.ErrCount, StringFormat=报警 {0}}"
                                       FontSize="11" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ClockText" FontSize="12" Margin="14,0,0,0"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TitleSubBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Row1 模块页签条：9 个模块 + 右上系统菜单 ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource TabStripBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <RadioButton Style="{DynamicResource MainTab}" GroupName="MainNav"
                                 Content="测试"
                                 Command="{Binding ShowTestCenterCommand}"
                                 IsChecked="{Binding SelectedNavKey, Converter={StaticResource NavKeyIs}, ConverterParameter=Test, Mode=TwoWay}"/>
                    <RadioButton Style="{DynamicResource MainTab}" GroupName="MainNav"
                                 Content="{DynamicResource Nav.Manual}"
                                 Command="{Binding ShowManualCommand}"
                                 IsChecked="{Binding SelectedNavKey, Converter={StaticResource NavKeyIs}, ConverterParameter=Manual, Mode=TwoWay}"/>
                    <Rectangle Width="1" Fill="{DynamicResource DividerBrush}" Margin="8,9"/>
                    <RadioButton Style="{DynamicResource MainTab}" GroupName="MainNav"
                                 Content="{DynamicResource Nav.Log}"
                                 Command="{Binding ShowLogCommand}"
                                 IsChecked="{Binding SelectedNavKey, Converter={StaticResource NavKeyIs}, ConverterParameter=Log, Mode=TwoWay}"/>
                    <RadioButton Style="{DynamicResource MainTab}" GroupName="MainNav"
                                 Content="{DynamicResource Nav.Settings}"
                                 Command="{Binding ShowConfigCommand}"
                                 IsChecked="{Binding SelectedNavKey, Converter={StaticResource NavKeyIs}, ConverterParameter=Settings, Mode=TwoWay}"/>
                </StackPanel>

                <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0">
                    <MenuItem Header="系统">
                        <MenuItem Header="打开数据目录" Command="{Binding OpenDataDirCommand}"/>
                        <MenuItem Header="打开日志目录" Command="{Binding OpenLogDirCommand}"/>
                        <MenuItem Header="打开方案目录" Command="{Binding OpenTestConfigDirCommand}"/>
                        <Separator/>
                        <MenuItem Header="开始测试" Command="{Binding StartSelectedRunCommand}" InputGestureText="F5"/>
                        <MenuItem Header="停止测试" Command="{Binding StopSelectedRunCommand}"/>
                        <Separator/>
                        <MenuItem Header="测试方案配置" Command="{Binding ShowConfigPlanCommand}"/>
                        <MenuItem Header="工位配置" Command="{Binding ShowConfigSlotsCommand}"/>
                        <MenuItem Header="偏好设置（语言 / 更新）" Command="{Binding ShowSettingsCommand}"/>
                        <Separator/>
                        <MenuItem Header="深色主题" Command="{Binding ShowDarkThemeCommand}"/>
                        <MenuItem Header="浅色主题" Command="{Binding ShowLightThemeCommand}"/>
                        <Separator/>
                        <MenuItem Header="全屏切换" InputGestureText="F11" Click="ToggleFullscreen_Click"/>
                        <MenuItem Header="版本信息与更新" Command="{Binding ShowVersionInfoCommand}"/>
                        <MenuItem Header="关于 M30 Test Console" Click="About_Click"/>
                        <Separator/>
                        <MenuItem Header="退出" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ═══ Row2 命令条：主操作 + 当前模式/工步 + 方案 ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶  开始测试"
                            Style="{DynamicResource ToolbarStartButton}"
                            Command="{Binding StartSelectedRunCommand}"
                            FontSize="13" MinWidth="112"
                            ToolTip="按当前选中的测试模式开始测试"/>
                    <Button Content="■  停止"
                            Style="{DynamicResource ToolbarStopButton}"
                            Command="{Binding StopSelectedRunCommand}"
                            FontSize="13" MinWidth="82" Margin="8,0,0,0"/>
                    <!-- 测试类型选择器：自动测试 / 长期稳定性 / 快速测试 共用同一个表格页面。
                         两道分隔线一起包在可折叠组里，否则非测试页会剩下一条孤立的空分隔线。 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavKey}" Value="Test">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Separator Style="{DynamicResource ToolbarSeparator}"/>
                        <TextBlock Text="测试类型" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Style="{DynamicResource ModeTab}" GroupName="TestMode" Content="自动测试"
                                     Command="{Binding ShowTestRunCommand}"
                                     IsChecked="{Binding TestMode, Converter={StaticResource NavKeyIs}, ConverterParameter=Auto, Mode=TwoWay}"/>
                        <RadioButton Style="{DynamicResource ModeTab}" GroupName="TestMode" Content="长期稳定性"
                                     Command="{Binding ShowLongTermStabilityCommand}"
                                     IsChecked="{Binding TestMode, Converter={StaticResource NavKeyIs}, ConverterParameter=LongTerm, Mode=TwoWay}"/>
                        <RadioButton Style="{DynamicResource ModeTab}" GroupName="TestMode" Content="快速测试"
                                     Command="{Binding ShowQuickTestCommand}"
                                     IsChecked="{Binding TestMode, Converter={StaticResource NavKeyIs}, ConverterParameter=Quick, Mode=TwoWay}"/>
                        <Separator Style="{DynamicResource ToolbarSeparator}"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,0" MaxWidth="430">
                        <TextBlock Text="当前工步" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding CurrentRunStep}" FontSize="11.5"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentRunStep}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PlanTitle}" FontSize="11.5"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Row3 工作区（全宽） ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource BgBrush}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>

        <!-- ═══ Row4 状态栏：设备 LED 组 | 就绪 | 版本 ═══ -->
        <Border Grid.Row="4" Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}"
                                             Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.8"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource StatusLedText}"/>
                                    <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                               Foreground="{Binding DotBrush}" Margin="4,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Width="1" Height="14" Fill="{DynamicResource DividerBrush}"
                               VerticalAlignment="Center" Margin="2,0,12,0"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource LedOnBrush}"
                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="系统就绪   ·   F11 全屏" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding VersionText, StringFormat=M30 Test Console {0}}"
                           FontSize="10.5" Margin="0,0,2,0"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
