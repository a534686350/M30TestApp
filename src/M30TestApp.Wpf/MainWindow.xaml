<Window x:Class="M30TestApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
        xmlns:local="clr-namespace:M30TestApp.Wpf"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        mc:Ignorable="d"
        Title="{DynamicResource App.Title}"
        Icon="/app.ico"
        Height="820" Width="1440"
        MinHeight="640" MinWidth="1080"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="31"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row0 标题栏：品牌块 | 运行状态 LED | 工步 | 时钟 ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="4" Height="18" Fill="{DynamicResource AccentBrush}" Margin="12,0,8,0"/>
                    <TextBlock Text="{Binding StationTitle}"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TitleFgBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VersionText}"
                               FontSize="10.5" Margin="10,1,0,0"
                               Foreground="{DynamicResource TitleSubBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="压力传感器自动测试系统 V2"
                               FontSize="10.5" Margin="14,1,0,0"
                               Foreground="{DynamicResource TitleSubBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Padding="7,2" Background="{DynamicResource RunStatusBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentRunStatus}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border MaxWidth="380" Margin="10,0,0,0">
                        <TextBlock Text="{Binding CurrentRunStep}" FontSize="11"
                                   Foreground="{DynamicResource TitleSubBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentRunStep}"/>
                    </Border>
                    <TextBlock x:Name="ClockText" FontSize="11.5" Margin="16,0,0,0"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TitleSubBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Row1 菜单栏 ═══ -->
        <Menu Grid.Row="1"
              Background="{DynamicResource MenuBarBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="系统(_S)">
                <MenuItem Header="打开数据目录" Command="{Binding OpenDataDirCommand}"/>
                <MenuItem Header="打开日志目录" Command="{Binding OpenLogDirCommand}"/>
                <MenuItem Header="打开方案目录" Command="{Binding OpenTestConfigDirCommand}"/>
                <Separator/>
                <MenuItem Header="退出" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="测试(_T)">
                <MenuItem Header="开始测试" Command="{Binding StartSelectedRunCommand}" InputGestureText="F5"/>
                <MenuItem Header="停止测试" Command="{Binding StopSelectedRunCommand}"/>
                <Separator/>
                <MenuItem Header="全自动测试" Command="{Binding ShowTestRunCommand}"/>
                <MenuItem Header="长期稳定性" Command="{Binding ShowLongTermStabilityCommand}"/>
                <MenuItem Header="手动调试" Command="{Binding ShowManualCommand}"/>
                <MenuItem Header="快速测试" Command="{Binding ShowQuickTestCommand}"/>
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="测试方案配置" Command="{Binding ShowConfigPlanCommand}"/>
                <MenuItem Header="工位配置" Command="{Binding ShowConfigSlotsCommand}"/>
                <MenuItem Header="系统设置" Command="{Binding ShowSettingsCommand}"/>
                <MenuItem Header="运行日志" Command="{Binding ShowLogCommand}"/>
                <Separator/>
                <MenuItem Header="深色主题" Command="{Binding ShowDarkThemeCommand}"/>
                <MenuItem Header="浅色主题" Command="{Binding ShowLightThemeCommand}"/>
                <Separator/>
                <MenuItem Header="全屏切换" InputGestureText="F11" Click="ToggleFullscreen_Click"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="版本信息与更新" Command="{Binding ShowVersionInfoCommand}"/>
                <MenuItem Header="关于 M30 Test Console" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ═══ Row2 工具栏：主操作 ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶  开始测试"
                            Style="{DynamicResource ToolbarStartButton}"
                            Command="{Binding StartSelectedRunCommand}"
                            FontSize="13" MinWidth="110"
                            ToolTip="按当前选中的测试模式开始测试"/>
                    <Button Content="■  停止"
                            Style="{DynamicResource ToolbarStopButton}"
                            Command="{Binding StopSelectedRunCommand}"
                            FontSize="13" MinWidth="80" Margin="8,0,0,0"/>
                    <Separator Style="{DynamicResource ToolbarSeparator}"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock Text="测试模式" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding CurrentRunModeTitle}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <Separator Style="{DynamicResource ToolbarSeparator}"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,0" MaxWidth="430">
                        <TextBlock Text="当前工步" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding CurrentRunStep}" FontSize="11.5"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentRunStep}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PlanTitle}" FontSize="11.5"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Row3 主工作区：扁平导航 + 内容 ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,8">

                        <TextBlock Text="测 试 执 行" Style="{StaticResource NavGroupTitle}" Margin="14,4,0,4"/>
                        <RadioButton Style="{DynamicResource NavButton}" IsChecked="True" GroupName="MainNav"
                                     Command="{Binding ShowTestRunCommand}"
                                     Content="{DynamicResource Nav.TestRun}"/>
                        <RadioButton Style="{DynamicResource NavButton}" GroupName="MainNav"
                                     Command="{Binding ShowLongTermStabilityCommand}"
                                     Content="{DynamicResource Nav.LongTermStability}"/>
                        <RadioButton Style="{DynamicResource NavButton}" GroupName="MainNav"
                                     Command="{Binding ShowManualCommand}"
                                     Content="{DynamicResource Nav.Manual}"/>
                        <RadioButton Style="{DynamicResource NavButton}" GroupName="MainNav"
                                     Command="{Binding ShowQuickTestCommand}"
                                     Content="{DynamicResource Nav.QuickTest}"/>

                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="12,10"/>

                        <TextBlock Text="数 据 与 配 置" Style="{StaticResource NavGroupTitle}" Margin="14,2,0,4"/>
                        <RadioButton Style="{DynamicResource NavButton}" GroupName="MainNav"
                                     Command="{Binding ShowConfigPlanCommand}"
                                     Content="{DynamicResource Nav.Plan}"/>
                        <RadioButton Style="{DynamicResource NavButton}" GroupName="MainNav"
                                     Command="{Binding ShowConfigSlotsCommand}"
                                     Content="{DynamicResource Nav.Slots}"/>
                        <RadioButton Style="{DynamicResource NavButton}" GroupName="MainNav"
                                     Command="{Binding ShowConfigCommand}"
                                     Content="{DynamicResource Nav.Config}"/>
                        <RadioButton Style="{DynamicResource NavButton}" GroupName="MainNav"
                                     Command="{Binding ShowLogCommand}"
                                     Content="{DynamicResource Nav.Log}"/>
                        <RadioButton Style="{DynamicResource NavButton}" GroupName="MainNav"
                                     Command="{Binding ShowSettingsCommand}"
                                     Content="{DynamicResource Nav.Settings}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Padding="10" Background="{DynamicResource BgBrush}">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>

        <!-- ═══ Row4 状态栏：设备 LED 组 | 就绪 | 版本 ═══ -->
        <Border Grid.Row="4" Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}"
                                             Stroke="#FFAAB4C0" StrokeThickness="0.8"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Title}" FontSize="11"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                               Foreground="{Binding DotBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Width="1" Height="14" Fill="{DynamicResource BorderBrush}"
                               VerticalAlignment="Center" Margin="2,0,12,0"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="系统就绪   ·   F11 全屏" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding VersionText, StringFormat=M30 Test Console {0}}"
                           FontSize="10.5" Margin="0,0,2,0"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
