<Window x:Class="M30TestApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
        xmlns:conv="clr-namespace:M30TestApp.Wpf.Converters"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        mc:Ignorable="d"
        Title="{DynamicResource App.Title}"
        Icon="/app.ico"
        Height="860" Width="1480"
        MinHeight="640" MinWidth="1080"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <!--
        上位机外壳 v5（2026-11-19）—— 标准工业测试软件骨架：
        1. 顶栏 52px：品牌 + 方案/工位/设备模式胶囊 + 当前工步 + 状态/报警/时钟/工具。
        2. 左侧分组导航 168px：测试任务 / 生产管理 / 系统 三组，图标 + 文字标签；
           顶部是开始/停止主操作，替代原来右侧 60px 纯图标条（找功能全靠悬停提示）。
        3. 主工作区占满剩余宽度，状态栏 28px 显示各设备 LED。
        4. 导航选中态走 MainViewModel 现有的 IsTabXxx（OneWay），不设 GroupName：
           互斥由 SelectedNavKey 单一来源保证，再叠加组内互斥会和单向绑定打架。
    -->
    <Window.Resources>
        <conv:NavKeyIsConverter x:Key="NavKeyIs"/>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BannerChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleSubBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 顶栏小图标按钮：主题 / 全屏 / 系统菜单 -->
        <Style x:Key="TopIconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航：分组标题 -->
        <Style x:Key="NavGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="14,14,0,6"/>
        </Style>

        <!-- 左侧导航：一级项（图标 + 文字，选中态左侧强调条 + 主色淡底） -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="6,0,6,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                           RadiusX="1.5" RadiusY="1.5" Fill="Transparent"/>
                                <ContentPresenter Margin="16,0,8,0"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </Style>

        <!-- 左侧主操作：开始 / 停止 -->
        <Style x:Key="NavActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row0 顶栏 52：品牌 | 方案/工位/模式 ‖ 当前工步 ‖ 状态/报警/时钟/工具 ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="4" Height="20" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="M30 压力传感器自动测试系统"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleFgBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Style="{StaticResource Chip}" Margin="14,0,0,0">
                        <TextBlock Text="{Binding PlanTitle}" Style="{StaticResource ChipText}"/>
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                        <TextBlock Text="{Binding StationTitle, StringFormat=工位 · {0}}"
                                   Style="{StaticResource ChipText}"/>
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="6,0,0,0"
                            ToolTip="在「配置 → 系统设置 → 行为」里勾选/取消「使用 SIM 模拟设备」切换">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding DeviceModeLed}"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding DeviceModeText}" FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 当前工步居中 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center" MaxWidth="440">
                    <TextBlock Text="当前工步" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentRunStep}" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                               Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding CurrentRunStep}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource LedOnBrush}"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CurrentRunStatus}" FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" Background="{DynamicResource BannerAlarmBrush}" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource LedErrorBrush}"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding TestRun.ErrCount, StringFormat=报警 {0}}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ClockText" FontSize="{StaticResource FontSizeSmall}" Margin="14,0,8,0"
                               FontFamily="Consolas" Foreground="{DynamicResource TitleSubBrush}" VerticalAlignment="Center"/>

                    <Button Content="&#xE706;" Style="{StaticResource TopIconButton}"
                            Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ToggleThemeText}"/>
                    <Button Content="&#xE740;" Style="{StaticResource TopIconButton}"
                            Click="ToggleFullscreen_Click" ToolTip="全屏 / 还原（F11）"/>
                    <Button Content="&#xE712;" Style="{StaticResource TopIconButton}"
                            Click="OpenSystemMenu_Click" ToolTip="系统菜单">
                        <!-- ContextMenu 不在可视树里，DataContext 不会继承，必须显式桥接 PlacementTarget -->
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="打开数据目录" Command="{Binding OpenDataDirCommand}"/>
                                <MenuItem Header="打开日志目录" Command="{Binding OpenLogDirCommand}"/>
                                <MenuItem Header="打开方案目录" Command="{Binding OpenTestConfigDirCommand}"/>
                                <Separator/>
                                <MenuItem Header="开始测试" Command="{Binding StartSelectedRunCommand}" InputGestureText="F5"/>
                                <MenuItem Header="停止测试" Command="{Binding StopSelectedRunCommand}"/>
                                <Separator/>
                                <MenuItem Header="测试方案配置" Command="{Binding ShowConfigPlanCommand}"/>
                                <MenuItem Header="工位配置" Command="{Binding ShowConfigSlotsCommand}"/>
                                <MenuItem Header="偏好设置（语言 / 更新）" Command="{Binding ShowSettingsCommand}"/>
                                <Separator/>
                                <MenuItem Header="版本信息与更新" Command="{Binding ShowVersionInfoCommand}"/>
                                <MenuItem Header="关于 M30 Test Console" Click="About_Click"/>
                                <Separator/>
                                <MenuItem Header="退出" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Row1 主体：左侧分组导航 + 工作区 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- 主操作 -->
                    <Grid DockPanel.Dock="Top" Margin="12,12,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource NavActionButton}"
                                Background="{DynamicResource SuccessBrush}"
                                Content="&#xE768;" Command="{Binding StartSelectedRunCommand}"
                                ToolTip="开始测试（F5）"/>
                        <Button Grid.Column="2" Style="{StaticResource NavActionButton}"
                                Background="{DynamicResource ErrorBrush}"
                                Content="&#xE71A;" Command="{Binding StopSelectedRunCommand}"
                                ToolTip="停止当前测试"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Text="运行控制" HorizontalAlignment="Center"
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,2"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="测试任务" Style="{StaticResource NavGroupTitle}"/>

                            <RadioButton Style="{StaticResource NavItem}" Command="{Binding ShowTestRunCommand}"
                                         IsChecked="{Binding IsTabAuto, Mode=OneWay}"
                                         ToolTip="自动测试：按方案逐温度点 × 逐压力点采集">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="自动测试" Style="{StaticResource NavLabel}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavItem}" Command="{Binding ShowLongTermStabilityCommand}"
                                         IsChecked="{Binding IsTabLongTerm, Mode=OneWay}"
                                         ToolTip="长期稳定性：长时间连续采集，观察漂移">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="长期稳定性" Style="{StaticResource NavLabel}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavItem}" Command="{Binding ShowQuickTestCommand}"
                                         IsChecked="{Binding IsTabQuick, Mode=OneWay}"
                                         ToolTip="快速测试：单工位快速验证">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="快速测试" Style="{StaticResource NavLabel}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavItem}" Command="{Binding ShowManualCommand}"
                                         IsChecked="{Binding IsTabManual, Mode=OneWay}"
                                         ToolTip="手动调试：设备点动与单次读数">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC7A;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="手动调试" Style="{StaticResource NavLabel}"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="生产管理" Style="{StaticResource NavGroupTitle}"/>

                            <RadioButton Style="{StaticResource NavItem}" Command="{Binding ShowSlotsCommand}"
                                         IsChecked="{Binding IsTabSlots, Mode=OneWay}"
                                         ToolTip="工位表：按数量生成，不扫码">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80A;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="工位表" Style="{StaticResource NavLabel}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavItem}" Command="{Binding ShowLogCommand}"
                                         IsChecked="{Binding IsTabLog, Mode=OneWay}"
                                         ToolTip="运行日志">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D5;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="运行日志" Style="{StaticResource NavLabel}"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="系统" Style="{StaticResource NavGroupTitle}"/>

                            <RadioButton Style="{StaticResource NavItem}" Command="{Binding ShowConfigCommand}"
                                         IsChecked="{Binding IsTabSettings, Mode=OneWay}"
                                         ToolTip="配置：方案 / 工位 / 设备 / 指令">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="系统配置" Style="{StaticResource NavLabel}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 工作区 -->
            <Border Grid.Column="1" Background="{DynamicResource BgBrush}">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>

        <!-- ═══ Row2 状态栏 28：设备 LED | 就绪 · 版本 ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}"
                                             Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.8"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StateText}" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{Binding DotBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Width="1" Height="13" Fill="{DynamicResource DividerBrush}"
                               VerticalAlignment="Center" Margin="2,0,12,0"/>
                    <TextBlock Text="系统就绪 · F11 全屏" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding VersionText, StringFormat=M30 Test Console {0}}"
                           FontSize="{StaticResource FontSizeCaption}" Margin="0,0,2,0"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
