<Application x:Class="M30TestApp.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:M30TestApp.Wpf"
             xmlns:vm="clr-namespace:M30TestApp.Wpf.ViewModels"
             xmlns:views="clr-namespace:M30TestApp.Wpf.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <ResourceDictionary Source="Strings/zh-CN.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:TestRunViewModel}">
                <views:TestRunView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ManualViewModel}">
                <views:ManualView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuickTestViewModel}">
                <views:QuickTestView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
                <views:ConfigView/>
            </DataTemplate>
            <!-- 顶部「工位」页签：无扫码的简化工位页（与配置页的工位节共用同一份数据） -->
            <DataTemplate DataType="{x:Type vm:SlotsViewModel}">
                <views:SlotsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogViewModel}">
                <views:LogView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
